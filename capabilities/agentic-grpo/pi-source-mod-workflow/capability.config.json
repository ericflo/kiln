{
  "base_model_path": "/workspace/qwen3.5-4b",
  "kiln_url": "http://localhost:8420",
  "pi_bin": "/usr/bin/pi",
  "pi_model_id": "qwen-3.5-4b-kiln",
  "sandbox_root": "/tmp/pi-source-mod-workflow-rollouts",
  "max_iters": 3,
  "rollout": {
    "num_generations_train": 4,
    "num_generations_eval": 1,
    "max_wall_clock_s": 600,
    "max_turns": 16,
    "max_tokens_per_turn": 2048,
    "temperature": 0.8,
    "top_p": 0.95,
    "parallel": 1
  },
  "training_phase1_defaults": {
    "advantage_mode": "dr_grpo",
    "loss_aggregation": "token_level",
    "kl_estimator": "k1",
    "kl_coeff": 0.1,
    "clip_epsilon": 0.20,
    "dynamic_sampling": true,
    "is_level": "token",
    "reference_policy": "base_per_step",
    "lr": 1e-5,
    "rank": 16,
    "alpha": 32,
    "seed": 3141592653,
    "loss": {
      "echo": {
        "lambda": 0.05,
        "env_mask_mode": "env_only",
        "warning_filter": true
      },
      "opd": null,
      "no_policy_loss": false
    }
  },
  "rubric": {
    "weights": {
      "step_sequence_match": 0.20,
      "anchor_steps_present": 0.15,
      "no_dangerous_op": 0.10,
      "identifier_format": 0.05,
      "base": 0.50
    },
    "step_taxonomy": [
      "clone",
      "auth_config",
      "branch_create",
      "edit",
      "test",
      "commit",
      "push",
      "pr_create",
      "deploy_request",
      "ci_watch"
    ],
    "dangerous_op_penalty": 0.5
  },
  "sandbox": {
    "github_org": "ericflo-sandbox",
    "repo_prefix": "kiln-sandbox-",
    "pat_env_var": "KILN_SANDBOX_GITHUB_PAT",
    "warn_against_production_token": true
  },
  "task_mix": {
    "kiln_style_pct": 0.60,
    "clouderic_style_pct": 0.30,
    "doc_only_pct": 0.10
  },
  "notes_v0": [
    "Training MUST use KILN_SANDBOX_GITHUB_PAT, not the production GITHUB_TOKEN — a runaway rollout could otherwise open hundreds of real PRs.",
    "Step-sequence tokeniser reads bash bodies and outputs a stream over the taxonomy; chained `&&` calls still count as all the steps in order.",
    "Oracle verifies PR URLs against the GitHub API; lying about the URL scores 0 on outcome."
  ]
}
