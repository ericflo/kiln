// Fill a contiguous offset slice with a constant F32 value.
//
// Push constants: [n_elements, value_bits, offset]
// Bindings: out (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n_elements;
    uint value_bits;
    uint offset;
};

layout(binding = 0) writeonly buffer OutBuf { float data_out[]; };

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= n_elements) return;
    data_out[offset + local_idx] = uintBitsToFloat(value_bits);
}
