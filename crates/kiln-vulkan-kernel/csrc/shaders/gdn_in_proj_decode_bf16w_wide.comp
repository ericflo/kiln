// Wide-column variant of `gdn_in_proj_decode_bf16w.comp`. Same
// computation (qkv + z + a + b projections concatenated into one
// output buffer) but with a 64-col workgroup for full NVIDIA
// cache-line utilization per warp read.
//
// Within-WG projection variation (some col_lanes may fall in
// different projections than others when a WG straddles a
// boundary) is handled the same way the unwide shader does —
// per-lane branch on `projection`. For Qwen3.5-4B the boundaries
// are at qkv_dim=8192 (multiple of 64) and z_dim=4096 (multiple
// of 64); only the small `a_dim`/`b_dim` (32 each) can lead to a
// straddling 64-col WG, where the within-WG branch path still
// produces correct output.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint qkv_dim;
    uint z_dim;
    uint a_dim;
    uint b_dim;
    uint total_out;
};

layout(binding = 0) readonly  buffer XBuf         { float data_x[];     };
layout(binding = 1) readonly  buffer QkvWeightBuf { uint  data_qkv_w[]; };
layout(binding = 2) readonly  buffer ZWeightBuf   { uint  data_z_w[];   };
layout(binding = 3) readonly  buffer AWeightBuf   { uint  data_a_w[];   };
layout(binding = 4) readonly  buffer BWeightBuf   { uint  data_b_w[];   };
layout(binding = 5) writeonly buffer OutBuf       { float data_out[];   };

shared float partial[256];

float unpack_bf16(uint packed, uint idx) {
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint out_idx = gl_WorkGroupID.x * 64 + col_lane;
    uint partial_idx = red_lane * 64 + col_lane;

    uint col = out_idx;
    uint width = qkv_dim;
    uint projection = 0;
    if (col >= qkv_dim) {
        col -= qkv_dim;
        width = z_dim;
        projection = 1;
    }
    if (projection == 1 && col >= z_dim) {
        col -= z_dim;
        width = a_dim;
        projection = 2;
    }
    if (projection == 2 && col >= a_dim) {
        col -= a_dim;
        width = b_dim;
        projection = 3;
    }

    float sum = 0.0;
    if (out_idx < total_out) {
        for (uint h = red_lane; h < hidden; h += 4) {
            uint off = h * width + col;
            float w = 0.0;
            if (projection == 0) {
                w = unpack_bf16(data_qkv_w[off >> 1], off);
            } else if (projection == 1) {
                w = unpack_bf16(data_z_w[off >> 1], off);
            } else if (projection == 2) {
                w = unpack_bf16(data_a_w[off >> 1], off);
            } else {
                w = unpack_bf16(data_b_w[off >> 1], off);
            }
            sum += data_x[h] * w;
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0 && out_idx < total_out) {
        float total = 0.0;
        [[unroll]] for (uint lane = 0; lane < 4; lane++) {
            total += partial[lane * 64 + col_lane];
        }
        data_out[out_idx] = total;
    }
}
