// Fuse GDN in-proj split, seq-len-1 depthwise conv, state advance, and QKV split.
//
// Input layout is projection-major:
//   qkv[batch, qkv_dim], z[batch, z_dim], a[batch, a_dim], b[batch, b_dim]
//
// Bindings:
//   0 in_proj_out[batch, qkv_dim + z_dim + a_dim + b_dim]
//   1 conv_weight[qkv_dim, kernel_size]
//   2 conv_state[batch, qkv_dim, kernel_size - 1] mutable
//   3 q_out[batch, qk_dim]
//   4 k_out[batch, qk_dim]
//   5 v_out[batch, v_dim]
//   6 z_out[batch, z_dim]
//   7 a_out[batch, a_dim]
//   8 b_out[batch, b_dim]
//
// Push constants:
//   batch, qkv_dim, qk_dim, v_dim, z_dim, a_dim, b_dim, kernel_size

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint batch;
    uint qkv_dim;
    uint qk_dim;
    uint v_dim;
    uint z_dim;
    uint a_dim;
    uint b_dim;
    uint kernel_size;
};

layout(binding = 0) readonly buffer InProjBuf { float data_in_proj[]; };
layout(binding = 1) readonly buffer WeightBuf { float data_weight[]; };
layout(binding = 2) buffer ConvStateBuf { float data_conv_state[]; };
layout(binding = 3) writeonly buffer QBuf { float data_q[]; };
layout(binding = 4) writeonly buffer KBuf { float data_k[]; };
layout(binding = 5) writeonly buffer VBuf { float data_v[]; };
layout(binding = 6) writeonly buffer ZBuf { float data_z[]; };
layout(binding = 7) writeonly buffer ABuf { float data_a[]; };
layout(binding = 8) writeonly buffer BBuf { float data_b[]; };

float silu(float x) {
    if (x >= 0.0) {
        return x / (1.0 + exp(-x));
    }
    float e = exp(x);
    return x * e / (1.0 + e);
}

void main() {
    const uint tid = gl_GlobalInvocationID.x;
    const uint qkv_total = batch * qkv_dim;
    const uint z_total = batch * z_dim;
    const uint a_total = batch * a_dim;
    const uint b_total = batch * b_dim;
    const uint total = qkv_total + z_total + a_total + b_total;
    if (tid >= total) {
        return;
    }

    if (tid < qkv_total) {
        const uint row = tid / qkv_dim;
        const uint c = tid - row * qkv_dim;
        const uint state_len = kernel_size - 1u;
        const uint state_base = (row * qkv_dim + c) * state_len;
        const float x = data_in_proj[tid];

        float sum = 0.0;
        for (uint k = 0u; k < kernel_size; k++) {
            float x_val = (k < state_len) ? data_conv_state[state_base + k] : x;
            sum += x_val * data_weight[c * kernel_size + k];
        }

        if (state_len > 0u) {
            for (uint s = 0u; s + 1u < state_len; s++) {
                data_conv_state[state_base + s] = data_conv_state[state_base + s + 1u];
            }
            data_conv_state[state_base + state_len - 1u] = x;
        }

        const float y = silu(sum);
        if (c < qk_dim) {
            data_q[row * qk_dim + c] = y;
        } else if (c < 2u * qk_dim) {
            const uint p = c - qk_dim;
            data_k[row * qk_dim + p] = y;
        } else if (c < 2u * qk_dim + v_dim) {
            const uint p = c - 2u * qk_dim;
            data_v[row * v_dim + p] = y;
        }
    } else if (tid < qkv_total + z_total) {
        const uint p = tid - qkv_total;
        data_z[p] = data_in_proj[tid];
    } else if (tid < qkv_total + z_total + a_total) {
        const uint p = tid - qkv_total - z_total;
        data_a[p] = data_in_proj[tid];
    } else {
        const uint p = tid - qkv_total - z_total - a_total;
        data_b[p] = data_in_proj[tid];
    }
}
