// Batched single-token full-attention Q/K/V projection with packed bf16 weights,
// writing the gated-Q layout directly to separate q, gate, k, and v outputs.
//
// Push constants:
//   hidden, q_dim, k_dim, v_dim, total_out, batch, head_dim
// where q_dim stores gated-Q as [num_heads, 2, head_dim].

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint q_dim;
    uint k_dim;
    uint v_dim;
    uint total_out;
    uint batch;
    uint head_dim;
};

layout(binding = 0) readonly buffer XBuf { float data_x[]; };
layout(binding = 1) readonly buffer QWeightBuf { uint data_q_w[]; };
layout(binding = 2) readonly buffer KWeightBuf { uint data_k_w[]; };
layout(binding = 3) readonly buffer VWeightBuf { uint data_v_w[]; };
layout(binding = 4) writeonly buffer QBuf { float data_q[]; };
layout(binding = 5) writeonly buffer GateBuf { float data_gate[]; };
layout(binding = 6) writeonly buffer KBuf { float data_k[]; };
layout(binding = 7) writeonly buffer VBuf { float data_v[]; };

shared float partial[256];

float unpack_bf16(uint packed, uint idx) {
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void write_result(uint row, uint projection, uint col, float value) {
    if (projection == 0u) {
        uint pair_stride = 2u * head_dim;
        uint head = col / pair_stride;
        uint local = col - head * pair_stride;
        uint dst = row * (q_dim >> 1u) + head * head_dim + (local % head_dim);
        if (local < head_dim) {
            data_q[dst] = value;
        } else {
            data_gate[dst] = value;
        }
    } else if (projection == 1u) {
        data_k[row * k_dim + col] = value;
    } else {
        data_v[row * v_dim + col] = value;
    }
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint col_groups = (total_out + 15u) / 16u;
    uint batch_idx = gl_WorkGroupID.x / col_groups;
    uint col_group = gl_WorkGroupID.x - batch_idx * col_groups;
    uint out_idx = col_group * 16u + col_lane;
    uint partial_idx = col_lane * 16u + red_lane;

    uint col = out_idx;
    uint width = q_dim;
    uint projection = 0u;
    if (col >= q_dim) {
        col -= q_dim;
        width = k_dim;
        projection = 1u;
    }
    if (projection == 1u && col >= k_dim) {
        col -= k_dim;
        width = v_dim;
        projection = 2u;
    }

    float sum = 0.0;
    if (batch_idx < batch && out_idx < total_out) {
        uint x_base = batch_idx * hidden;
        for (uint h = red_lane; h < hidden; h += 16u) {
            uint off = h * width + col;
            float w = projection == 0u
                ? unpack_bf16(data_q_w[off >> 1], off)
                : (projection == 1u
                    ? unpack_bf16(data_k_w[off >> 1], off)
                    : unpack_bf16(data_v_w[off >> 1], off));
            sum += data_x[x_base + h] * w;
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0u && batch_idx < batch && out_idx < total_out) {
        float total = 0.0;
        for (uint lane = 0u; lane < 16u; lane++) {
            total += partial[col_lane * 16u + lane];
        }
        write_result(batch_idx, projection, col, total);
    }
}
