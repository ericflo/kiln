// GDN full chunk forward kernel (fused prep + scan + state update).
//
// This mirrors the existing Vulkan split path for 64-token chunks:
//   1. gdn_chunk_prep produces bf16-rounded A/B masks, V', q_s_scaled,
//      decay_last_col, and p_last.
//   2. gdn_chunk_scan performs per-dv forward substitution and returns
//      out plus bf16-rounded W * decay_last_col.
//   3. Rust updates state with p_last * state + k_t @ w_weighted.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint batch;
    uint heads;
    uint chunk;
    uint dk;
    uint dv;
};

layout(binding = 0) readonly buffer GBuf { float data_g[]; };
layout(binding = 1) readonly buffer VBuf { float data_v[]; };
layout(binding = 2) readonly buffer KktBuf { float data_kkt[]; };
layout(binding = 3) readonly buffer QktBuf { float data_qkt[]; };
layout(binding = 4) readonly buffer KsEntryBuf { float data_ks_entry[]; };
layout(binding = 5) readonly buffer QSBuf { float data_q_s[]; };
layout(binding = 6) readonly buffer BetaBuf { float data_beta[]; };
layout(binding = 7) readonly buffer KTBuf { float data_k_t[]; };
layout(binding = 8) buffer StateBuf { float data_state[]; };
layout(binding = 9) writeonly buffer OutBuf { float data_out[]; };

shared float s_a_row[64];
shared float s_b_row[64];
shared float s_w[8192];
shared float s_big_g[64];
shared float s_p[64];
shared float s_decay_last[64];
shared float s_p_last;

float bf16_round(float x) {
    uint bits = floatBitsToUint(x);
    uint lsb = (bits >> 16) & 1u;
    bits += 0x7fffu + lsb;
    bits &= 0xffff0000u;
    return uintBitsToFloat(bits);
}

void main() {
    const uint C = 64;
    const uint MAX_DV = 128;

    uint bh = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint total_bh = batch * heads;
    if (bh >= total_bh || chunk != C || dv > MAX_DV) {
        return;
    }

    uint g_base = bh * C;
    uint cc_base = bh * C * C;
    uint cv_base = bh * C * dv;
    uint kt_base = bh * dk * C;
    uint state_base = bh * dk * dv;

    for (uint i = tid; i < C; i += 128) {
        s_big_g[i] = data_g[g_base + i];
    }
    barrier();

    if (tid == 0) {
        float acc = 0.0;
        for (uint i = 0; i < C; ++i) {
            acc += s_big_g[i];
            s_big_g[i] = acc;
        }
        s_p_last = bf16_round(exp(s_big_g[C - 1]));
    }
    barrier();

    for (uint i = tid; i < C; i += 128) {
        s_p[i] = exp(s_big_g[i]);
        s_decay_last[i] = bf16_round(exp(s_big_g[C - 1] - s_big_g[i]));
    }
    barrier();

    for (uint t = 0; t < C; ++t) {
        for (uint i = tid; i < C; i += 128) {
            uint ti = t * C + i;
            float decay = exp(s_big_g[t] - s_big_g[i]);
            float a_val = (i < t) ? data_kkt[cc_base + ti] * decay : 0.0;
            float b_val = (i <= t) ? data_qkt[cc_base + ti] * decay : 0.0;
            s_a_row[i] = bf16_round(a_val);
            s_b_row[i] = bf16_round(b_val);
        }
        barrier();

        if (tid < dv) {
            float acc_a = 0.0;
            for (uint i = 0; i < t; ++i) {
                acc_a += s_a_row[i] * s_w[i * MAX_DV + tid];
            }

            uint td = t * dv + tid;
            float p_t = s_p[t];
            float v_prime = bf16_round(data_v[cv_base + td] - data_ks_entry[cv_base + td] * p_t);
            float w_val = data_beta[g_base + t] * (v_prime - acc_a);
            s_w[t * MAX_DV + tid] = w_val;
        }
        barrier();

        if (tid < dv) {
            float intra = 0.0;
            for (uint i = 0; i <= t; ++i) {
                intra += s_b_row[i] * s_w[i * MAX_DV + tid];
            }

            uint td = t * dv + tid;
            float q_s_scaled = bf16_round(data_q_s[cv_base + td] * s_p[t]);
            data_out[cv_base + td] = q_s_scaled + intra;
        }
        barrier();
    }

    if (tid < dv) {
        for (uint k_idx = 0; k_idx < dk; ++k_idx) {
            float delta = 0.0;
            for (uint t = 0; t < C; ++t) {
                float w_weighted = bf16_round(s_w[t * MAX_DV + tid] * s_decay_last[t]);
                delta += data_k_t[kt_base + k_idx * C + t] * w_weighted;
            }
            uint state_idx = state_base + k_idx * dv + tid;
            float state_scaled = bf16_round(data_state[state_idx] * s_p_last);
            data_state[state_idx] = state_scaled + bf16_round(delta);
        }
    }
}
