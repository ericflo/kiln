// Batched 2D transpose: out[b, j, i] = in[b, i, j]
//
// Input shape [batch, rows, cols] → output [batch, cols, rows].
//
// Push constants: [batch, rows, cols]
// Bindings: in (readonly), out (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint batch;
    uint rows;
    uint cols;
};

layout(binding = 0) readonly  buffer InBuf  { float data_in[]; };
layout(binding = 1) writeonly buffer OutBuf { float data_out[]; };

void main() {
    uint bx = gl_WorkGroupID.z;
    if (bx >= batch) return;
    uint i = gl_GlobalInvocationID.y;
    uint j = gl_GlobalInvocationID.x;
    if (i >= rows || j >= cols) return;
    uint in_base  = bx * rows * cols;
    uint out_base = bx * cols * rows;
    data_out[out_base + j * rows + i] = data_in[in_base + i * cols + j];
}
