// Batched paged decode attention for Vulkan CPU/F32 tensors.
//
// Q layout:       [batch, 1, num_heads, head_dim]
// K/V layout:     [batch, max_seqlen, num_kv_heads, head_dim]
// seq_lens:       [batch] active K/V length per row
// Output layout:  [batch, 1, num_heads, head_dim]
//
// This is intentionally a decode-only kernel for q_len=1. One workgroup owns
// one (batch row, query head) pair. The kernel uses a three-pass online-safe
// softmax implementation over the compacted per-row K/V window.
#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint max_seqlen;
    uint num_heads;
    uint num_kv_heads;
    uint head_dim;
    float softmax_scale;
};

layout(binding = 0) readonly buffer QBuf { float data_q[]; };
layout(binding = 1) readonly buffer KBuf { float data_k[]; };
layout(binding = 2) readonly buffer VBuf { float data_v[]; };
layout(binding = 3) readonly buffer SeqLenBuf { uint data_seq_lens[]; };
layout(binding = 4) writeonly buffer OutBuf { float data_out[]; };

shared float partial[256];
shared float shared_logit;

float dot_for_token(
    uint batch_idx,
    uint q_head,
    uint kv_head,
    uint token_idx,
    uint lane,
    float q_lane
) {
    float part = 0.0;
    if (lane < head_dim) {
        uint k_idx = (((batch_idx * max_seqlen + token_idx) * num_kv_heads + kv_head) * head_dim) + lane;
        part = q_lane * data_k[k_idx];
    }
    partial[lane] = part;
    barrier();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (lane < stride) {
            partial[lane] += partial[lane + stride];
        }
        barrier();
    }

    if (lane == 0) {
        shared_logit = partial[0] * softmax_scale;
    }
    barrier();
    return shared_logit;
}

void main() {
    uint pair_idx = gl_WorkGroupID.x;
    uint q_head = pair_idx % num_heads;
    uint batch_idx = pair_idx / num_heads;
    uint lane = gl_LocalInvocationID.x;
    uint seq_len = data_seq_lens[batch_idx];
    uint gqa_ratio = num_heads / num_kv_heads;
    uint kv_head = q_head / gqa_ratio;

    uint q_base = ((batch_idx * num_heads + q_head) * head_dim);
    float q_lane = lane < head_dim ? data_q[q_base + lane] : 0.0;

    float max_logit = -3.4028234663852886e38;
    for (uint t = 0; t < seq_len; t++) {
        float logit = dot_for_token(batch_idx, q_head, kv_head, t, lane, q_lane);
        max_logit = max(max_logit, logit);
    }

    float denom = 0.0;
    for (uint t = 0; t < seq_len; t++) {
        float logit = dot_for_token(batch_idx, q_head, kv_head, t, lane, q_lane);
        denom += exp(logit - max_logit);
    }

    float acc = 0.0;
    for (uint t = 0; t < seq_len; t++) {
        float logit = dot_for_token(batch_idx, q_head, kv_head, t, lane, q_lane);
        float weight = exp(logit - max_logit) / denom;
        if (lane < head_dim) {
            uint v_idx = (((batch_idx * max_seqlen + t) * num_kv_heads + kv_head) * head_dim) + lane;
            acc += weight * data_v[v_idx];
        }
    }

    if (lane < head_dim) {
        uint out_idx = ((batch_idx * num_heads + q_head) * head_dim) + lane;
        data_out[out_idx] = acc;
    }
}
