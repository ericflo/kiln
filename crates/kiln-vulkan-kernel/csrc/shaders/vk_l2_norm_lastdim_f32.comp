// Last-dim L2 normalization:
//   out[row, i] = x[row, i] * scale / sqrt(sum_j x[row, j]^2 + eps)
//
// Push constants: rows, hidden, scale_bits, eps_bits

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint rows;
    uint hidden;
    float scale;
    float eps;
};

layout(binding = 0) readonly buffer XBuf { float x[]; };
layout(binding = 1) writeonly buffer OutBuf { float out_data[]; };

shared float reduce_sh[256];

void main() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= rows) return;

    uint base = row * hidden;
    float xv = (tid < hidden) ? x[base + tid] : 0.0;
    reduce_sh[tid] = xv * xv;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (tid < stride) {
            reduce_sh[tid] += reduce_sh[tid + stride];
        }
        barrier();
    }

    float inv = scale * inversesqrt(reduce_sh[0] + eps);
    if (tid < hidden) {
        out_data[base + tid] = xv * inv;
    }
}
