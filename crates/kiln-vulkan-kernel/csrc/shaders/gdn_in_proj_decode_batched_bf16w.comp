// Batched single-token GDN input projections with packed bf16 weights.
//
// Output layout is projection-major:
//   qkv[batch, qkv_dim], z[batch, z_dim], a[batch, a_dim], b[batch, b_dim].
#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 80, local_size_y = 3, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint qkv_dim;
    uint z_dim;
    uint a_dim;
    uint b_dim;
    uint total_out;
    uint batch;
};

layout(binding = 0) readonly buffer XBuf { float data_x[]; };
layout(binding = 1) readonly buffer QkvWeightBuf { uint data_qkv_w[]; };
layout(binding = 2) readonly buffer ZWeightBuf { uint data_z_w[]; };
layout(binding = 3) readonly buffer AWeightBuf { uint data_a_w[]; };
layout(binding = 4) readonly buffer BWeightBuf { uint data_b_w[]; };
layout(binding = 5) writeonly buffer OutBuf { float data_out[]; };

shared float partial[240];

float unpack_bf16(uint packed, uint idx) {
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint col_groups = (total_out + 79) / 80;
    uint batch_idx = gl_WorkGroupID.x / col_groups;
    uint col_group = gl_WorkGroupID.x - batch_idx * col_groups;
    uint out_idx = col_group * 80 + col_lane;
    uint partial_idx = col_lane * 3 + red_lane;

    uint col = out_idx;
    uint width = qkv_dim;
    uint projection = 0;

    if (col >= qkv_dim) {
        col -= qkv_dim;
        width = z_dim;
        projection = 1;
    }
    if (projection == 1 && col >= z_dim) {
        col -= z_dim;
        width = a_dim;
        projection = 2;
    }
    if (projection == 2 && col >= a_dim) {
        col -= a_dim;
        width = b_dim;
        projection = 3;
    }

    float sum = 0.0;
    if (batch_idx < batch && out_idx < total_out) {
        uint x_base = batch_idx * hidden;
        for (uint h = red_lane; h < hidden; h += 3) {
            uint off = h * width + col;
            float w = 0.0;
            if (projection == 0) {
                w = unpack_bf16(data_qkv_w[off >> 1], off);
            } else if (projection == 1) {
                w = unpack_bf16(data_z_w[off >> 1], off);
            } else if (projection == 2) {
                w = unpack_bf16(data_a_w[off >> 1], off);
            } else {
                w = unpack_bf16(data_b_w[off >> 1], off);
            }
            sum += data_x[x_base + h] * w;
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0 && batch_idx < batch && out_idx < total_out) {
        float total = 0.0;
        for (uint lane = 0; lane < 3; lane++) {
            total += partial[col_lane * 3 + lane];
        }

        uint dst = 0;
        if (projection == 0) {
            dst = batch_idx * qkv_dim + col;
        } else if (projection == 1) {
            dst = batch * qkv_dim + batch_idx * z_dim + col;
        } else if (projection == 2) {
            dst = batch * (qkv_dim + z_dim) + batch_idx * a_dim + col;
        } else {
            dst = batch * (qkv_dim + z_dim + a_dim) + batch_idx * b_dim + col;
        }
        data_out[dst] = total;
    }
}
