// Backward of vk_repeat_kv_heads: sum gradients across each group.
// in:  [heads_kv * groups, rows, head_dim]  (grad w.r.t. broadcasted output)
// out: [heads_kv, rows, head_dim]  (grad w.r.t. original KV)
//
// out[h_kv, r, d] = sum_{g in 0..groups} in[h_kv * groups + g, r, d]
//
// Push constants: [heads_kv, groups, rows, head_dim]

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint heads_kv;
    uint groups;
    uint rows;
    uint head_dim;
};

layout(binding = 0) readonly  buffer InBuf  { float data_in[]; };
layout(binding = 1) writeonly buffer OutBuf { float data_out[]; };

void main() {
    uint linear = gl_GlobalInvocationID.x;
    uint total = heads_kv * rows * head_dim;
    if (linear >= total) return;

    uint d = linear % head_dim;
    uint hr = linear / head_dim;
    uint r = hr % rows;
    uint h_kv = hr / rows;

    float acc = 0.0;
    for (uint g = 0u; g < groups; ++g) {
        uint h_q = h_kv * groups + g;
        acc += data_in[(h_q * rows + r) * head_dim + d];
    }
    data_out[linear] = acc;
}
