// Narrow backward along the last dim: scatter the gradient slice back
// into a zero-padded full-shape buffer.
//
// Push constants: [outer, inner_in, start, len]
// Bindings: grad_out (readonly, [outer, len]), grad_in (writeonly, [outer, inner_in])
//
// The caller is responsible for zero-initializing grad_in before
// dispatch — this kernel only writes the slice's region, so untouched
// elements stay at their initial value.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint outer;
    uint inner_in;
    uint start;
    uint len;
};

layout(binding = 0) readonly  buffer GradOutBuf { float data_gy[]; };
layout(binding = 1) writeonly buffer GradInBuf  { float data_gx[]; };

void main() {
    uint linear = gl_GlobalInvocationID.x;
    uint total = outer * len;
    if (linear >= total) return;
    uint i = linear / len;
    uint j = linear % len;
    data_gx[i * inner_in + (start + j)] = data_gy[linear];
}
