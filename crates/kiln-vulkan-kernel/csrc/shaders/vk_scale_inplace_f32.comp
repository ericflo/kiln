// In-place scalar multiply: data[i] *= scale (push-constant float).
//
// Push constants: [n_elements, scale_bits]
// Bindings: data (read-write)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n_elements;
    uint scale_bits;
};

layout(binding = 0) buffer DataBuf { float data[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_elements) return;
    float scale = uintBitsToFloat(scale_bits);
    data[idx] = data[idx] * scale;
}
