// Permute [heads, rows, head_dim] -> [rows, heads, head_dim]
// over a contiguous output offset slice.
//
// Push constants: [heads, rows, head_dim, n_elements, offset]
// Bindings: in (readonly), out (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint heads;
    uint rows;
    uint head_dim;
    uint n_elements;
    uint offset;
};

layout(binding = 0) readonly  buffer InBuf  { float data_in[]; };
layout(binding = 1) writeonly buffer OutBuf { float data_out[]; };

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= n_elements) return;
    uint linear = offset + local_idx;
    uint total = heads * rows * head_dim;
    if (linear >= total) return;
    uint d = linear % head_dim;
    uint rh = linear / head_dim;
    uint h = rh % heads;
    uint r = rh / heads;
    uint src = (h * rows + r) * head_dim + d;
    data_out[linear] = data_in[src];
}
