// Element-wise binary op over a contiguous offset slice:
//   out[offset + i] = a[offset + i] OP b[offset + i]
//
// Push constants: [n_elements, op_code, offset]
// Bindings: a (readonly), b (readonly), out (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n_elements;
    uint op_code;
    uint offset;
};

layout(binding = 0) readonly  buffer ABuf   { float data_a[]; };
layout(binding = 1) readonly  buffer BBuf   { float data_b[]; };
layout(binding = 2) writeonly buffer OutBuf { float data_out[]; };

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= n_elements) return;
    uint idx = offset + local_idx;
    float a = data_a[idx];
    float b = data_b[idx];
    float r;
    if (op_code == 0u) {
        r = a + b;
    } else if (op_code == 1u) {
        r = a - b;
    } else if (op_code == 2u) {
        r = a * b;
    } else {
        r = a / b;
    }
    data_out[idx] = r;
}
