// SiLU backward over a contiguous offset slice:
//   dL/dx = dL/dy * sigmoid(x) * (1 + x * (1 - sigmoid(x)))
//
// Push constants: [n_elements, offset]
// Bindings: x (readonly), grad_out (readonly), grad_in (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n_elements;
    uint offset;
};

layout(binding = 0) readonly  buffer XBuf       { float data_x[]; };
layout(binding = 1) readonly  buffer GradOutBuf { float data_gy[]; };
layout(binding = 2) writeonly buffer GradInBuf  { float data_gx[]; };

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= n_elements) return;
    uint idx = offset + local_idx;
    float x = data_x[idx];
    float gy = data_gy[idx];
    float sx;
    if (x >= 0.0) {
        sx = 1.0 / (1.0 + exp(-x));
    } else {
        float e = exp(x);
        sx = e / (1.0 + e);
    }
    float dsilu = sx * (1.0 + x * (1.0 - sx));
    data_gx[idx] = gy * dsilu;
}
