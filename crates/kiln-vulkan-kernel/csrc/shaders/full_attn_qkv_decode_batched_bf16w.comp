// Batched fused single-token full-attention Q/K/V projections with packed bf16 weights.
//
// Computes three row-vector matmuls per batch row in one dispatch:
//   q[b] = x[b, hidden] * q_weight_t[hidden, q_dim]
//   k[b] = x[b, hidden] * k_weight_t[hidden, k_dim]
//   v[b] = x[b, hidden] * v_weight_t[hidden, v_dim]
//
// Input and output are f32; weights are packed two bf16 values per uint and
// expanded explicitly in shader. Output layout matches the unbatched kernel's
// concatenation, strided by batch.
#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint q_dim;
    uint k_dim;
    uint v_dim;
    uint total_out;
    uint batch;
};

layout(binding = 0) readonly buffer XBuf { float data_x[]; };
layout(binding = 1) readonly buffer QWeightBuf { uint data_q_w[]; };
layout(binding = 2) readonly buffer KWeightBuf { uint data_k_w[]; };
layout(binding = 3) readonly buffer VWeightBuf { uint data_v_w[]; };
layout(binding = 4) writeonly buffer OutBuf { float data_out[]; };

shared float partial[256];

float unpack_bf16(uint packed, uint idx) {
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint col_groups = (total_out + 15u) / 16u;
    uint batch_idx = gl_WorkGroupID.x / col_groups;
    uint col_group = gl_WorkGroupID.x - batch_idx * col_groups;
    uint out_idx = col_group * 16u + col_lane;
    uint partial_idx = col_lane * 16u + red_lane;

    uint col = out_idx;
    uint width = q_dim;
    uint projection = 0u;
    if (col >= q_dim) {
        col -= q_dim;
        width = k_dim;
        projection = 1u;
    }
    if (projection == 1u && col >= k_dim) {
        col -= k_dim;
        width = v_dim;
        projection = 2u;
    }

    float sum = 0.0;
    if (batch_idx < batch && out_idx < total_out) {
        uint x_base = batch_idx * hidden;
        for (uint h = red_lane; h < hidden; h += 16u) {
            uint off = h * width + col;
            float w = projection == 0u
                ? unpack_bf16(data_q_w[off >> 1], off)
                : (projection == 1u
                    ? unpack_bf16(data_k_w[off >> 1], off)
                    : unpack_bf16(data_v_w[off >> 1], off));
            sum += data_x[x_base + h] * w;
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0u && batch_idx < batch && out_idx < total_out) {
        float total = 0.0;
        for (uint lane = 0u; lane < 16u; lane++) {
            total += partial[col_lane * 16u + lane];
        }
        data_out[batch_idx * total_out + out_idx] = total;
    }
}
