// GRPO per-token loss and d(loss_row)/d(policy_logprob).
//
// policy_logprob = correct_logit - (log(global_sumexp) + global_max)
// log_ratio      = policy_logprob - ref_logprob
//
// is_mode:
//   0 token:     -min(ratio * adv, clamp(ratio, lo, hi) * adv)
//   1 cispo:     -detach(clamp(ratio, lo, hi) * adv) * policy_logprob
//   2 reinforce: -adv
//
// kl_mode:
//   0 none
//   1 k1: kl_coeff * log_ratio
//   3 k3: kl_coeff * (exp(-log_ratio) - 1 + log_ratio)
//
// coeff[row] stores d(loss_row)/d(policy_logprob). The backward shader
// multiplies it by grad_out / num_active and by d logprob / d logits.
//
// Push constants:
//   [num_active, advantage_bits, clip_low_bits, clip_high_bits,
//    kl_coeff_bits, kl_mode, is_mode]
// Bindings:
//   global_max, global_sumexp, correct, ref_logprob, out_loss, out_coeff

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint num_active;
    uint advantage_bits;
    uint clip_low_bits;
    uint clip_high_bits;
    uint kl_coeff_bits;
    uint kl_mode;
    uint is_mode;
};

layout(binding = 0) readonly  buffer GMaxBuf      { float global_max[]; };
layout(binding = 1) readonly  buffer GSumExpBuf   { float global_sumexp[]; };
layout(binding = 2) readonly  buffer CorrectBuf   { float correct[]; };
layout(binding = 3) readonly  buffer RefLogpBuf   { float ref_logprob[]; };
layout(binding = 4) writeonly buffer LossBuf      { float per_row_loss[]; };
layout(binding = 5) writeonly buffer CoeffBuf     { float coeff[]; };

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= num_active) return;

    float advantage = uintBitsToFloat(advantage_bits);
    float clip_low = uintBitsToFloat(clip_low_bits);
    float clip_high = uintBitsToFloat(clip_high_bits);
    float kl_coeff = uintBitsToFloat(kl_coeff_bits);

    float lse = log(global_sumexp[row]) + global_max[row];
    float policy_logprob = correct[row] - lse;
    float log_ratio = policy_logprob - ref_logprob[row];
    float ratio = exp(log_ratio);
    float lo = 1.0 - clip_low;
    float hi = 1.0 + clip_high;
    // CISPO's clip_high is an absolute upper IS-weight cap and deliberately
    // has no lower floor. PPO/GRPO modes retain additive epsilon bounds.
    float clipped_ratio = is_mode == 1u ? min(ratio, clip_high) : clamp(ratio, lo, hi);

    float kl_penalty = 0.0;
    float kl_grad = 0.0;
    if (kl_mode == 1u) {
        kl_penalty = kl_coeff * log_ratio;
        kl_grad = kl_coeff;
    } else if (kl_mode == 3u) {
        float exp_neg = exp(-log_ratio);
        kl_penalty = kl_coeff * (exp_neg - 1.0 + log_ratio);
        kl_grad = kl_coeff * (1.0 - exp_neg);
    }

    float loss = 0.0;
    float policy_coeff = 0.0;
    if (is_mode == 1u) {
        float weight = clipped_ratio * advantage;
        loss = -weight * policy_logprob;
        policy_coeff = -weight;
    } else if (is_mode == 2u) {
        loss = -advantage;
        policy_coeff = -advantage;
    } else {
        float surr1 = ratio * advantage;
        float surr2 = clipped_ratio * advantage;
        bool take_surr1 = surr1 <= surr2;
        float surrogate = take_surr1 ? surr1 : surr2;
        float d_clipped = (ratio >= lo && ratio <= hi) ? ratio : 0.0;
        float d_surrogate = take_surr1 ? (advantage * ratio) : (advantage * d_clipped);
        loss = -surrogate;
        policy_coeff = -d_surrogate;
    }

    per_row_loss[row] = loss + kl_penalty;
    coeff[row] = policy_coeff + kl_grad;
}
