// Wide-column variant of `linear_decode_bf16w`. Each workgroup covers
// 64 consecutive output columns (vs 16 in the unwide kernel), so a
// single NVIDIA 128-byte cache line load — which holds 64 bf16
// weights — is fully consumed per warp memory transaction. The
// unwide shader uses only 16 of those 64 columns (25% cache-line
// utilization), the rest being read into L1 but never touched.
//
// Layout:
//   - workgroup size (col_lane=64) × (red_lane=4) = 256 threads
//   - workgroup count = out_dim / 64
//   - per col_lane: handles 1 output, accumulates over hidden/4 weights
//
// Better suited to large `out_dim` like the LM head (151936 / 64 =
// 2374 workgroups, easily saturating the 144 SMs). For small
// `out_dim` (e.g. 2560 → 40 workgroups), the unwide 16x16 shader
// is better — caller picks per-call.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint out_dim;
};

layout(binding = 0) readonly  buffer XBuf      { float data_x[];   };
layout(binding = 1) readonly  buffer WeightBuf { uint  data_w[];   };
layout(binding = 2) writeonly buffer OutBuf    { float data_out[]; };

shared float partial[256];

float load_weight(uint idx) {
    uint packed = data_w[idx >> 1];
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint col = gl_WorkGroupID.x * 64 + col_lane;
    uint partial_idx = red_lane * 64 + col_lane;

    float sum = 0.0;
    if (col < out_dim) {
        for (uint h = red_lane; h < hidden; h += 4) {
            sum += data_x[h] * load_weight(h * out_dim + col);
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0 && col < out_dim) {
        float total = 0.0;
        [[unroll]] for (uint lane = 0; lane < 4; lane++) {
            total += partial[lane * 64 + col_lane];
        }
        data_out[col] = total;
    }
}
