#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint out_dim;
    uint hidden;
    uint batch;
    uint row_offset;
};

layout(binding = 0) readonly buffer GradOutBuf { float data_grad_out[]; };
layout(binding = 1) readonly buffer WeightBuf { uint data_w[]; };
layout(binding = 2) writeonly buffer GradInBuf { float data_grad_in[]; };

shared float partial[256];

float load_weight(uint idx) {
    uint packed = data_w[idx >> 1];
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint col_groups = (hidden + 31) / 32;
    uint local_row = gl_WorkGroupID.x / col_groups;
    uint col_group = gl_WorkGroupID.x - local_row * col_groups;
    uint col = col_group * 32 + col_lane;
    uint partial_idx = col_lane * 8 + red_lane;

    float sum = 0.0;
    if (local_row < batch && col < hidden) {
        uint row = row_offset + local_row;
        uint grad_base = row * out_dim;
        for (uint k = red_lane; k < out_dim; k += 8) {
            sum += data_grad_out[grad_base + k] * load_weight(k * hidden + col);
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0 && local_row < batch && col < hidden) {
        float total = 0.0;
        for (uint lane = 0; lane < 8; lane++) {
            total += partial[col_lane * 8 + lane];
        }
        uint row = row_offset + local_row;
        data_grad_in[row * hidden + col] = total;
    }
}
