// Wide-column variant of `full_attn_qkv_decode_bf16w.comp`. Each
// workgroup handles 64 consecutive output columns from the
// concatenated [Q | K | V] output. Cache-line aligned reads — see
// the rationale comment in `linear_decode_bf16w_wide.comp`.
//
// Assumes q_dim, k_dim, v_dim are all multiples of 64 (true for
// Qwen3.5-4B: 8192, 1024, 1024) so each workgroup stays within a
// single projection — no within-WG branching needed.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 64, local_size_y = 4, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint hidden;
    uint q_dim;
    uint k_dim;
    uint v_dim;
    uint total_out;
};

layout(binding = 0) readonly  buffer XBuf       { float data_x[];   };
layout(binding = 1) readonly  buffer QWeightBuf { uint  data_q_w[]; };
layout(binding = 2) readonly  buffer KWeightBuf { uint  data_k_w[]; };
layout(binding = 3) readonly  buffer VWeightBuf { uint  data_v_w[]; };
layout(binding = 4) writeonly buffer OutBuf     { float data_out[]; };

shared float partial[256];

float unpack_bf16(uint packed, uint idx) {
    uint bf16_bits = ((idx & 1u) == 0u) ? (packed & 0xffffu) : (packed >> 16);
    return uintBitsToFloat(bf16_bits << 16);
}

void main() {
    uint col_lane = gl_LocalInvocationID.x;
    uint red_lane = gl_LocalInvocationID.y;
    uint out_idx = gl_WorkGroupID.x * 64 + col_lane;
    uint partial_idx = red_lane * 64 + col_lane;

    uint col = out_idx;
    uint width = q_dim;
    uint projection = 0;
    if (col >= q_dim) {
        col -= q_dim;
        width = k_dim;
        projection = 1;
    }
    if (projection == 1 && col >= k_dim) {
        col -= k_dim;
        width = v_dim;
        projection = 2;
    }

    float sum = 0.0;
    if (out_idx < total_out) {
        for (uint h = red_lane; h < hidden; h += 4) {
            uint off = h * width + col;
            float w = projection == 0
                ? unpack_bf16(data_q_w[off >> 1], off)
                : (projection == 1
                    ? unpack_bf16(data_k_w[off >> 1], off)
                    : unpack_bf16(data_v_w[off >> 1], off));
            sum += data_x[h] * w;
        }
    }

    partial[partial_idx] = sum;
    barrier();

    if (red_lane == 0 && out_idx < total_out) {
        float total = 0.0;
        [[unroll]] for (uint lane = 0; lane < 4; lane++) {
            total += partial[lane * 64 + col_lane];
        }
        data_out[out_idx] = total;
    }
}
