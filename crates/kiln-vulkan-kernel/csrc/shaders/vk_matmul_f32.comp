// F32 matmul: C[M, N] = A[M, K] @ B[K, N]
//
// Simple tiled implementation: each workgroup of 16x16 threads
// computes a 16x16 tile of C, accumulating partials over K via
// shared-memory staging of A and B tiles.
//
// Push constants: [M, N, K]
// Bindings:
//   0: A (readonly, [M*K] F32)
//   1: B (readonly, [K*N] F32)
//   2: C (writeonly, [M*N] F32)

#version 450
#extension GL_EXT_control_flow_attributes : enable

const uint TILE = 16;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint M;
    uint N;
    uint K;
};

layout(binding = 0) readonly  buffer ABuf { float a[]; };
layout(binding = 1) readonly  buffer BBuf { float b[]; };
layout(binding = 2) writeonly buffer CBuf { float c[]; };

shared float tile_a[TILE][TILE];
shared float tile_b[TILE][TILE];

void main() {
    uint global_row = gl_GlobalInvocationID.y; // M dim
    uint global_col = gl_GlobalInvocationID.x; // N dim
    uint local_row = gl_LocalInvocationID.y;
    uint local_col = gl_LocalInvocationID.x;

    float acc = 0.0;
    uint num_tiles = (K + TILE - 1u) / TILE;

    for (uint t = 0u; t < num_tiles; ++t) {
        uint a_col = t * TILE + local_col;
        uint b_row = t * TILE + local_row;

        // Cooperative load with bounds check.
        if (global_row < M && a_col < K) {
            tile_a[local_row][local_col] = a[global_row * K + a_col];
        } else {
            tile_a[local_row][local_col] = 0.0;
        }
        if (b_row < K && global_col < N) {
            tile_b[local_row][local_col] = b[b_row * N + global_col];
        } else {
            tile_b[local_row][local_col] = 0.0;
        }

        barrier();

        [[unroll]]
        for (uint k = 0u; k < TILE; ++k) {
            acc += tile_a[local_row][k] * tile_b[k][local_col];
        }

        barrier();
    }

    if (global_row < M && global_col < N) {
        c[global_row * N + global_col] = acc;
    }
}
