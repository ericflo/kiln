// Fused gated multiply:
//   out[i] = a[i] * sigmoid(gate[i])
//
// Push constants: [n_elements]
// Bindings: a (readonly), gate (readonly), out (writeonly)

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint n_elements;
};

layout(binding = 0) readonly  buffer ABuf    { float data_a[]; };
layout(binding = 1) readonly  buffer GateBuf { float data_gate[]; };
layout(binding = 2) writeonly buffer OutBuf  { float data_out[]; };

float sigmoid_stable(float x) {
    if (x >= 0.0) {
        return 1.0 / (1.0 + exp(-x));
    }
    float e = exp(x);
    return e / (1.0 + e);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_elements) return;
    data_out[idx] = data_a[idx] * sigmoid_stable(data_gate[idx]);
}
