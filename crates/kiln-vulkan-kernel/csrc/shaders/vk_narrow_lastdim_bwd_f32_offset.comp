// Narrow backward over a contiguous grad_out offset slice.
//
// Push constants: [outer, inner_in, start, len, n_elements, offset]
// Bindings: grad_out (readonly, [outer, len]), grad_in (writeonly, [outer, inner_in])

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint outer;
    uint inner_in;
    uint start;
    uint len;
    uint n_elements;
    uint offset;
};

layout(binding = 0) readonly  buffer GradOutBuf { float data_gy[]; };
layout(binding = 1) writeonly buffer GradInBuf  { float data_gx[]; };

void main() {
    uint local_idx = gl_GlobalInvocationID.x;
    if (local_idx >= n_elements) return;
    uint linear = offset + local_idx;
    uint total = outer * len;
    if (linear >= total) return;
    uint i = linear / len;
    uint j = linear % len;
    data_gx[i * inner_in + (start + j)] = data_gy[linear];
}
