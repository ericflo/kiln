// Exact causal GQA SDPA backward for dQ over a query-row tile.
//
// Push constants: total_rows, row_start, rows_chunk, heads_q, heads_kv, head_dim, scale_bits

#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint total_rows;
    uint row_start;
    uint rows_chunk;
    uint heads_q;
    uint heads_kv;
    uint head_dim;
    float scale;
};

layout(binding = 0) readonly buffer QBuf { float q[]; };
layout(binding = 1) readonly buffer KBuf { float k[]; };
layout(binding = 2) readonly buffer VBuf { float v[]; };
layout(binding = 3) readonly buffer DOutBuf { float d_out[]; };
layout(binding = 4) readonly buffer LseBuf { float lse[]; };
layout(binding = 5) readonly buffer DeltaBuf { float delta[]; };
layout(binding = 6) writeonly buffer DQBuf { float d_q[]; };

shared float reduce_sh[32];

float workgroup_sum(float value, uint tid) {
    float sg_sum = subgroupAdd(value);
    if (subgroupElect()) {
        reduce_sh[gl_SubgroupID] = sg_sum;
    }
    barrier();

    float total_part = (tid < gl_NumSubgroups) ? reduce_sh[tid] : 0.0;
    float total = subgroupAdd(total_part);
    if (tid == 0u) {
        reduce_sh[0] = total;
    }
    barrier();
    return reduce_sh[0];
}

void main() {
    uint local_row = gl_WorkGroupID.x;
    uint row = row_start + local_row;
    uint hq = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    if (local_row >= rows_chunk || row >= total_rows || hq >= heads_q) return;

    uint groups = heads_q / heads_kv;
    uint hkv = hq / groups;
    uint q_base = (row * heads_q + hq) * head_dim;
    float q_val = (tid < head_dim) ? q[q_base + tid] : 0.0;
    float dout_val = (tid < head_dim) ? d_out[q_base + tid] : 0.0;
    float lse_v = lse[row * heads_q + hq];
    float delta_v = delta[row * heads_q + hq];
    float acc = 0.0;

    for (uint key_row = 0u; key_row <= row; ++key_row) {
        uint kv_base = (key_row * heads_kv + hkv) * head_dim;

        float dot_term = (tid < head_dim) ? q_val * k[kv_base + tid] : 0.0;
        float p = exp(workgroup_sum(dot_term, tid) * scale - lse_v);

        float dp_term = (tid < head_dim) ? dout_val * v[kv_base + tid] : 0.0;
        float ds = p * (workgroup_sum(dp_term, tid) - delta_v);

        if (tid < head_dim) {
            acc += ds * k[kv_base + tid] * scale;
        }
    }

    if (tid < head_dim) {
        d_q[q_base + tid] = acc;
    }
}
