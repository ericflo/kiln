// Batched K/V token write into the Vulkan-resident paged pool.
//
// Inputs:
//   - k_in   : f32, [batch, num_kv_heads * head_dim]
//   - v_in   : f32, [batch, num_kv_heads * head_dim]
//   - slots  : u32, [batch], one resolved destination slot per row
//
// Outputs:
//   - k_pool : f32, [total_slots, num_kv_heads, head_dim]
//   - v_pool : f32, [total_slots, num_kv_heads, head_dim]
//
// Push constants: batch, elements_per_slot, total_slots.

#version 450
#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint batch;
    uint elements_per_slot;
    uint total_slots;
};

layout(binding = 0) readonly  buffer KInBuf    { float data_k_in[];   };
layout(binding = 1) readonly  buffer VInBuf    { float data_v_in[];   };
layout(binding = 2) readonly  buffer SlotsBuf  { uint  data_slots[];  };
layout(binding = 3) writeonly buffer KPoolBuf  { float data_k_pool[]; };
layout(binding = 4) writeonly buffer VPoolBuf  { float data_v_pool[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint total = batch * elements_per_slot;
    if (i >= total) return;

    uint row = i / elements_per_slot;
    uint elem = i - row * elements_per_slot;
    uint slot = data_slots[row];
    if (slot >= total_slots) return;
    uint src = row * elements_per_slot + elem;
    uint dst = slot * elements_per_slot + elem;

    data_k_pool[dst] = data_k_in[src];
    data_v_pool[dst] = data_v_in[src];
}
