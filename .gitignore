Qwen3.5-4B/

# Default runtime state directory (adapter_dir + .eval/{suites,datasets,judgments})
/adapters/

# Profiling artifact dumps (kept in git history only).
# Root-anchored: these were unanchored and shadowed tracked same-named
# directories (docs/archive/profiling/, assets/profiling/).
/c12-out/
/profile-out/
/profile/
/profiling/
/profiling-artifacts/

# Local hardware qualification output. Compact validated receipts live under
# qualification/receipts; raw logs, traces, and profiles stay here.
.qualification/

# Raw benchmark, serving, metrics, and profiler output. Retain compact receipts,
# summaries, manifests, and hashes instead.
*.log
*.sse
*.prom
*.trace
*.prof
*.profile
*.nsys-rep
*.qdrep
*.nvvp
*.perf.data

# Raw audit evidence under docs/audits/ (run captures, probe dumps, candidate
# patches, sweep summaries). Audit .md receipts stay tracked; raw dumps are
# local-only, retained in git history.
docs/audits/**/*.json
docs/audits/**/*.jsonl
docs/audits/**/*.ndjson
docs/audits/**/*.txt
docs/audits/**/*.diff
docs/audits/**/*.status
# Exception: the removed-raw-artifacts manifest is a compact receipt cited by
# docs/ARTIFACT_RETENTION.md (policy: retain compact receipts, summaries,
# manifests, and hashes).
!docs/audits/removed-raw-artifacts-2026-07-13-v1.json

# Vulkan SPIR-V build artifacts
*.spv

# Node tooling for screenshot capture (see scripts/capture-desktop-screenshots.mjs)
node_modules/
package.json
package-lock.json
scripts/docs-site/node_modules/
