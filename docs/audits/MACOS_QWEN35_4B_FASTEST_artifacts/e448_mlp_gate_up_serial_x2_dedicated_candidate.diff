+kernel void kiln_mlp_gate_up_serial_x2_bf16(
+    device const bfloat* x [[buffer(0)]],
+    device const bfloat* gate_t [[buffer(1)]],
+    device const bfloat* up_t [[buffer(2)]],
+    device bfloat* out [[buffer(3)]],
+    constant uint& hidden [[buffer(4)]],
+    constant uint& intermediate [[buffer(5)]],
+    uint gid [[thread_position_in_grid]]
+) {
+    const uint cols2 = intermediate >> 1;
+    if (gid >= cols2) {
+        return;
+    }
+
+    const uint col0 = gid << 1;
+    float gate_acc0 = 0.0f;
+    float up_acc0 = 0.0f;
+    float gate_acc1 = 0.0f;
+    float up_acc1 = 0.0f;
+    for (uint i = 0; i < hidden; i += 2) {
+        const bfloat2 xv = *(device const bfloat2*)(x + i);
+        const float x0 = static_cast<float>(xv[0]);
+        const float x1 = static_cast<float>(xv[1]);
+        const uint w_idx0 = i * intermediate + col0;
+        const uint w_idx1 = w_idx0 + intermediate;
+        const bfloat2 gate_w0 = *(device const bfloat2*)(gate_t + w_idx0);
+        const bfloat2 gate_w1 = *(device const bfloat2*)(gate_t + w_idx1);
+        const bfloat2 up_w0 = *(device const bfloat2*)(up_t + w_idx0);
+        const bfloat2 up_w1 = *(device const bfloat2*)(up_t + w_idx1);
+        gate_acc0 += x0 * static_cast<float>(gate_w0[0]) + x1 * static_cast<float>(gate_w1[0]);
+        up_acc0 += x0 * static_cast<float>(up_w0[0]) + x1 * static_cast<float>(up_w1[0]);
+        gate_acc1 += x0 * static_cast<float>(gate_w0[1]) + x1 * static_cast<float>(gate_w1[1]);
+        up_acc1 += x0 * static_cast<float>(up_w0[1]) + x1 * static_cast<float>(up_w1[1]);
+    }
+
+    const float gate_sigmoid0 = 1.0f / (1.0f + exp(-gate_acc0));
+    const float gate_sigmoid1 = 1.0f / (1.0f + exp(-gate_acc1));
+    out[col0] = static_cast<bfloat>((gate_acc0 * gate_sigmoid0) * up_acc0);
+    out[col0 + 1] = static_cast<bfloat>((gate_acc1 * gate_sigmoid1) * up_acc1);
+}
