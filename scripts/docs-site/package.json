{
  "name": "kiln-docs-site-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:utilities": "tailwindcss -i tailwind.css -o ../../docs/site/css/utilities.css --content '../../docs/site/**/*.html' --minify",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "markdown-it": "14.3.0",
    "puppeteer-core": "24.31.0",
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=20"
  }
}
