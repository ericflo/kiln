{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ericflo.github.io/kiln/contracts/kiln-openenv-v1.schema.json",
  "title": "Kiln OpenEnv rollout, evaluation, and artifact contract",
  "description": "Environment discovery identity, canonical episode provenance, exact replay transcripts, paired held-out return evaluation receipts, offline verification reports, verified artifact-download receipts, and content-addressed summaries published by `kiln openenv`.",
  "$ref": "#/$defs/OpenEnvRolloutSummary",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "OpenEnvArtifactDownloadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "kind",
        "source_url",
        "output_path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-artifact-download.v1" },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "kind": { "type": "string", "minLength": 1 },
        "source_url": {
          "type": "string",
          "pattern": "^/v1/openenv/runs/[0-9a-fA-F-]{36}/artifacts/[^/?#]+$"
        },
        "output_path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Sha256" },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "readme_content": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "documentation_url": { "type": ["string", "null"] }
      }
    },
    "EnvironmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "client_profile",
        "base_url",
        "websocket_url",
        "openapi_version",
        "environments",
        "metadata",
        "schema_sha256"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-identity.v1" },
        "client_profile": { "const": "openenv-http/1.x" },
        "base_url": { "type": "string", "minLength": 1 },
        "websocket_url": { "type": "string", "pattern": "^wss?://" },
        "authentication": {
          "type": "string",
          "enum": ["none", "bearer"],
          "default": "none",
          "description": "Request authentication applied to both discovery and the WebSocket upgrade. Credential handles and secrets are excluded."
        },
        "openapi_version": { "type": ["string", "null"] },
        "environments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": { "$ref": "#/$defs/Metadata" },
        "schema_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EnvironmentSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "observation", "state"],
      "properties": {
        "action": {},
        "observation": {},
        "state": {}
      }
    },
    "EnvironmentInspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "schema"],
      "properties": {
        "identity": { "$ref": "#/$defs/EnvironmentIdentity" },
        "schema": { "$ref": "#/$defs/EnvironmentSchema" }
      }
    },
    "ProtocolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_JSON",
            "UNKNOWN_TYPE",
            "VALIDATION_ERROR",
            "EXECUTION_ERROR",
            "CAPACITY_REACHED",
            "FACTORY_ERROR",
            "SESSION_ERROR"
          ]
        },
        "message": { "type": "string" },
        "errors": { "type": "array" },
        "active_sessions": { "type": "integer", "minimum": 0 },
        "max_sessions": { "type": "integer", "minimum": 0 },
        "factory_name": { "type": "string" }
      }
    },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "reward", "done"],
      "properties": {
        "observation": {},
        "reward": { "type": ["null", "boolean", "integer", "number"] },
        "done": { "type": "boolean" },
        "metadata": {}
      }
    },
    "EpisodeTermination": {
      "type": "string",
      "enum": ["done", "max_steps", "invalid_model_action", "protocol_error"]
    },
    "RolloutRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_index",
        "candidate_index",
        "environment_name",
        "environment_url",
        "seed",
        "steps",
        "episode_return",
        "terminal_done",
        "termination",
        "recoverable_protocol_errors",
        "capacity_retries",
        "model_tokens",
        "model_latency_ms"
      ],
      "properties": {
        "group_index": { "type": "integer", "minimum": 0 },
        "candidate_index": { "type": "integer", "minimum": 0 },
        "environment_name": { "type": "string", "minLength": 1 },
        "environment_url": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "steps": { "type": "integer", "minimum": 0, "maximum": 256 },
        "episode_return": { "type": "number" },
        "terminal_done": { "type": "boolean" },
        "termination": { "$ref": "#/$defs/EpisodeTermination" },
        "protocol_error_code": { "type": "string", "minLength": 1 },
        "recoverable_protocol_errors": { "type": "integer", "minimum": 0 },
        "capacity_retries": { "type": "integer", "minimum": 0 },
        "model_tokens": { "type": "integer", "minimum": 0 },
        "model_latency_ms": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "termination": { "const": "done" } },
            "required": ["termination"]
          },
          "then": {
            "properties": { "terminal_done": { "const": true } }
          },
          "else": {
            "properties": { "terminal_done": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "termination": { "const": "protocol_error" } },
            "required": ["termination"]
          },
          "then": { "required": ["protocol_error_code"] },
          "else": { "not": { "required": ["protocol_error_code"] } }
        }
      ]
    },
    "RolloutStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mean_episode_return",
        "min_episode_return",
        "max_episode_return",
        "done_count",
        "max_steps_count",
        "invalid_model_action_count",
        "protocol_error_count",
        "recoverable_protocol_error_count",
        "capacity_retry_count",
        "total_environment_steps",
        "total_model_tokens",
        "mean_model_latency_ms"
      ],
      "properties": {
        "mean_episode_return": { "type": "number" },
        "min_episode_return": { "type": ["number", "null"] },
        "max_episode_return": { "type": ["number", "null"] },
        "done_count": { "type": "integer", "minimum": 0 },
        "max_steps_count": { "type": "integer", "minimum": 0 },
        "invalid_model_action_count": { "type": "integer", "minimum": 0 },
        "protocol_error_count": { "type": "integer", "minimum": 0 },
        "recoverable_protocol_error_count": { "type": "integer", "minimum": 0 },
        "capacity_retry_count": { "type": "integer", "minimum": 0 },
        "total_environment_steps": { "type": "integer", "minimum": 0 },
        "total_model_tokens": { "type": "integer", "minimum": 0 },
        "mean_model_latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "OpenEnvRolloutSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kiln_url",
        "adapter",
        "adapter_label",
        "environments",
        "groups",
        "group_size",
        "rollout_count",
        "seed_start",
        "max_steps",
        "concurrency",
        "max_action_tokens",
        "temperature",
        "thinking",
        "protocol_error_reward",
        "max_recoverable_errors",
        "capacity_wait_seconds",
        "reset_plan_sha256",
        "output_path",
        "replay_output_path",
        "summary_output_path",
        "dataset_sha256",
        "dataset_bytes",
        "replay_sha256",
        "replay_bytes",
        "stats",
        "rollouts"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-rollout-summary.v3" },
        "kiln_url": { "type": "string", "minLength": 1 },
        "adapter": { "type": ["string", "null"] },
        "adapter_label": { "type": "string", "minLength": 1 },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/EnvironmentInspection" }
        },
        "groups": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "group_size": { "type": "integer", "minimum": 1, "maximum": 256 },
        "rollout_count": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "seed_start": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 256 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_action_tokens": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "temperature": { "type": "number", "minimum": 0 },
        "thinking": { "type": "boolean" },
        "protocol_error_reward": { "type": "number" },
        "max_recoverable_errors": { "type": "integer", "minimum": 0, "maximum": 64 },
        "capacity_wait_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "reset_plan_sha256": {
          "$ref": "#/$defs/Sha256",
          "description": "SHA-256 of the ordered seed-free reset template array aligned with environments."
        },
        "output_path": { "type": "string", "minLength": 1 },
        "replay_output_path": { "type": "string", "minLength": 1 },
        "summary_output_path": { "type": "string", "minLength": 1 },
        "dataset_sha256": { "$ref": "#/$defs/Sha256" },
        "dataset_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "replay_sha256": { "$ref": "#/$defs/Sha256" },
        "replay_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "stats": { "$ref": "#/$defs/RolloutStats" },
        "rollouts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/RolloutRecord" }
        },
        "training_submission": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ReplayExchangeResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "observation"],
          "properties": {
            "kind": { "const": "observation" },
            "observation": { "$ref": "#/$defs/Observation" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error", "continued"],
          "properties": {
            "kind": { "const": "protocol_error" },
            "error": { "$ref": "#/$defs/ProtocolError" },
            "continued": { "type": "boolean" }
          }
        }
      ]
    },
    "ReplayExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "action", "result"],
      "properties": {
        "step_index": { "type": "integer", "minimum": 0 },
        "action": { "type": "object" },
        "result": { "$ref": "#/$defs/ReplayExchangeResult" }
      }
    },
    "ReplayCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_index",
        "exchanges",
        "episode_return",
        "terminal_done",
        "termination",
        "recoverable_protocol_errors",
        "capacity_retries",
        "model_tokens",
        "model_latency_ms"
      ],
      "properties": {
        "candidate_index": { "type": "integer", "minimum": 0 },
        "exchanges": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ReplayExchange" }
        },
        "final_state": {},
        "episode_return": { "type": "number" },
        "terminal_done": { "type": "boolean" },
        "termination": { "$ref": "#/$defs/EpisodeTermination" },
        "recoverable_protocol_errors": { "type": "integer", "minimum": 0 },
        "capacity_retries": { "type": "integer", "minimum": 0 },
        "model_tokens": { "type": "integer", "minimum": 0 },
        "model_latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "ReplayGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_index",
        "environment_index",
        "seed",
        "reset_payload",
        "reset_observation",
        "candidates"
      ],
      "properties": {
        "group_index": { "type": "integer", "minimum": 0 },
        "environment_index": { "type": "integer", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "reset_payload": { "type": "object" },
        "reset_observation": { "$ref": "#/$defs/Observation" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/ReplayCandidate" }
        }
      }
    },
    "OpenEnvReplayManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "client_profile",
        "dataset_sha256",
        "protocol_error_reward",
        "max_steps",
        "environments",
        "groups"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-replay.v1" },
        "client_profile": { "const": "openenv-http/1.x" },
        "dataset_sha256": { "$ref": "#/$defs/Sha256" },
        "protocol_error_reward": { "type": "number" },
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 256 },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/EnvironmentInspection" }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "items": { "$ref": "#/$defs/ReplayGroup" }
        }
      }
    },
    "EnvironmentEvalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_mean_improvement"],
      "properties": {
        "min_mean_return": { "type": "number" },
        "min_mean_improvement": { "type": "number", "minimum": 0 }
      }
    },
    "EnvironmentEvalConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "group_size"],
      "properties": {
        "groups": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "group_size": { "type": "integer", "minimum": 1, "maximum": 256 },
        "seed_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gate": { "$ref": "#/$defs/EnvironmentEvalGate" }
      }
    },
    "PolicyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapter_content_revision": { "$ref": "#/$defs/Sha256" },
        "execution_provenance_sha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "EnvironmentEvalDecision": {
      "type": "string",
      "enum": ["diagnostic", "passed", "rejected", "inconclusive"]
    },
    "EnvironmentEvalOutcome": {
      "type": "string",
      "enum": ["diagnostic", "promoted", "kept", "rejected", "inconclusive", "error"]
    },
    "EnvironmentEvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "paired_groups",
        "paired_episodes",
        "minimum_paired_groups",
        "baseline_mean_return",
        "candidate_mean_return",
        "mean_return_improvement",
        "improved_groups",
        "regressed_groups",
        "tied_groups",
        "exact_sign_test_p_value",
        "exact_sign_test_alpha",
        "decision",
        "reason"
      ],
      "properties": {
        "policy_version": { "const": "paired_return_sign_test_v1" },
        "paired_groups": { "type": "integer", "minimum": 1 },
        "paired_episodes": { "type": "integer", "minimum": 1 },
        "minimum_paired_groups": { "const": 20 },
        "baseline_mean_return": { "type": "number" },
        "candidate_mean_return": { "type": "number" },
        "mean_return_improvement": { "type": "number" },
        "improved_groups": { "type": "integer", "minimum": 0 },
        "regressed_groups": { "type": "integer", "minimum": 0 },
        "tied_groups": { "type": "integer", "minimum": 0 },
        "exact_sign_test_p_value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "exact_sign_test_alpha": { "const": 0.05 },
        "decision": { "$ref": "#/$defs/EnvironmentEvalDecision" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "EnvironmentEvaluationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "run_id",
        "config",
        "seed_start",
        "baseline",
        "candidate",
        "baseline_summary_sha256",
        "candidate_summary_sha256",
        "evidence",
        "outcome",
        "verdict"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-environment-evaluation.v1" },
        "run_id": { "type": "string", "minLength": 1 },
        "config": { "$ref": "#/$defs/EnvironmentEvalConfig" },
        "seed_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "baseline": { "$ref": "#/$defs/PolicyIdentity" },
        "candidate": { "$ref": "#/$defs/PolicyIdentity" },
        "baseline_summary_sha256": { "$ref": "#/$defs/Sha256" },
        "candidate_summary_sha256": { "$ref": "#/$defs/Sha256" },
        "evidence": { "$ref": "#/$defs/EnvironmentEvalEvidence" },
        "outcome": { "$ref": "#/$defs/EnvironmentEvalOutcome" },
        "verdict": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "properties": { "decision": { "const": "diagnostic" } },
                "required": ["decision"]
              }
            },
            "required": ["evidence"]
          },
          "then": { "properties": { "outcome": { "const": "diagnostic" } } }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "properties": { "decision": { "const": "passed" } },
                "required": ["decision"]
              }
            },
            "required": ["evidence"]
          },
          "then": {
            "properties": {
              "outcome": { "enum": ["promoted", "kept", "error"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "properties": { "decision": { "const": "rejected" } },
                "required": ["decision"]
              }
            },
            "required": ["evidence"]
          },
          "then": { "properties": { "outcome": { "const": "rejected" } } }
        },
        {
          "if": {
            "properties": {
              "evidence": {
                "properties": { "decision": { "const": "inconclusive" } },
                "required": ["decision"]
              }
            },
            "required": ["evidence"]
          },
          "then": { "properties": { "outcome": { "const": "inconclusive" } } }
        }
      ]
    },
    "VerificationReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "summary_path",
        "dataset_path",
        "replay_path",
        "dataset_sha256",
        "replay_sha256",
        "groups",
        "rollouts",
        "environment_exchanges"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-verification.v1" },
        "summary_path": { "type": "string", "minLength": 1 },
        "dataset_path": { "type": "string", "minLength": 1 },
        "replay_path": { "type": "string", "minLength": 1 },
        "dataset_sha256": { "$ref": "#/$defs/Sha256" },
        "replay_sha256": { "$ref": "#/$defs/Sha256" },
        "groups": { "type": "integer", "minimum": 1 },
        "rollouts": { "type": "integer", "minimum": 1 },
        "environment_exchanges": { "type": "integer", "minimum": 0 }
      }
    },
    "ReplayRunReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "replay_sha256",
        "environments",
        "groups",
        "rollouts",
        "environment_exchanges",
        "capacity_retries",
        "environment_prefix_only_rollouts"
      ],
      "properties": {
        "schema": { "const": "kiln.openenv-replay-run.v1" },
        "replay_sha256": { "$ref": "#/$defs/Sha256" },
        "environments": { "type": "integer", "minimum": 1 },
        "groups": { "type": "integer", "minimum": 1 },
        "rollouts": { "type": "integer", "minimum": 1 },
        "environment_exchanges": { "type": "integer", "minimum": 0 },
        "capacity_retries": { "type": "integer", "minimum": 0 },
        "environment_prefix_only_rollouts": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
