{
  "schema": "kiln.host-thermal-policy.v1",
  "id": "strix-halo-serving-benchmark-c32-v1",
  "sensor": {
    "hwmon_name": "k10temp",
    "label": "Tctl"
  },
  "limit_millicelsius": 93000,
  "poll_interval_ms": 250,
  "pacing": {
    "start_millicelsius": 60000,
    "resume_millicelsius": 45000,
    "resume_stable_samples": 8
  },
  "safe_handoff": {
    "target_millicelsius": 45000,
    "stable_samples": 8,
    "timeout_seconds": 300.0
  },
  "phase_settlement_timeout_seconds": 300.0
}
