{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.invalid/schemas/wsl2-thermal-policy-v1.schema.json",
  "title": "Kiln WSL2 Thermal Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "content_sha256",
    "host",
    "gpu",
    "poll_interval_ms",
    "safe_handoff"
  ],
  "properties": {
    "schema": {
      "const": "kiln.wsl2-thermal-policy.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_name",
        "thermal_zone_name",
        "limit_millicelsius",
        "vendor_tjunction_millicelsius"
      ],
      "properties": {
        "cpu_name": {
          "type": "string",
          "minLength": 1
        },
        "thermal_zone_name": {
          "type": "string",
          "minLength": 1
        },
        "limit_millicelsius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "vendor_tjunction_millicelsius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "uuid",
        "limit_millicelsius"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "limit_millicelsius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        }
      }
    },
    "poll_interval_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    },
    "safe_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_target_millicelsius",
        "gpu_target_millicelsius",
        "stable_samples",
        "timeout_seconds"
      ],
      "properties": {
        "host_target_millicelsius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "gpu_target_millicelsius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "stable_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        }
      }
    }
  }
}
