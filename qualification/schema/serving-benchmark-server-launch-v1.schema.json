{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ericflo.github.io/kiln/schemas/serving-benchmark-server-launch-v1.schema.json",
  "title": "Kiln Serving Benchmark Server Launch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "command",
    "working_directory",
    "log_directory",
    "readiness_poll_interval_ms",
    "startup_timeout_seconds",
    "shutdown_timeout_seconds",
    "acceptable_exit_codes"
  ],
  "properties": {
    "schema": {
      "const": "kiln.serving-benchmark-server-launch.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "log_directory": {
      "type": "string",
      "minLength": 1
    },
    "readiness_poll_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "startup_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shutdown_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "acceptable_exit_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    }
  }
}
