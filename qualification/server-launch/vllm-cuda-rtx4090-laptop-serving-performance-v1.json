{
  "schema": "kiln.serving-benchmark-server-launch.v1",
  "id": "vllm-cuda-rtx4090-laptop-serving-performance-v1",
  "command": [
    "./.qualification/vllm-cuda-venv/bin/python-kiln",
    "scripts/vllm_teacher.py",
    "--model-path=.qualification/cuda-rtx4090-laptop/performance-model-v1",
    "--snapshot-root=.qualification/vllm-serving/cuda-rtx4090-laptop-performance-v1/snapshots",
    "--cache-root=.qualification/vllm-serving/cuda-rtx4090-laptop-performance-v1/caches",
    "--served-model-id=Qwen3.5-4B",
    "--process-group-mode=inherited",
    "--max-top-k=20",
    "--max-model-len=32768",
    "--max-provenance-read-mib-per-second=64",
    "--",
    "--host=127.0.0.1",
    "--port=8421",
    "--dtype=bfloat16",
    "--gpu-memory-utilization=0.75",
    "--max-num-seqs=64",
    "--max-num-batched-tokens=32768",
    "--kv-cache-dtype=auto",
    "--block-size=16",
    "--seed=0",
    "--scheduling-policy=fcfs",
    "--enable-prefix-caching",
    "--disable-custom-all-reduce",
    "--disable-uvicorn-access-log",
    "--disable-log-stats",
    "--language-model-only"
  ],
  "working_directory": "../..",
  "log_directory": "../../.qualification/vllm-serving/cuda-rtx4090-laptop-performance-v1/logs",
  "readiness_poll_interval_ms": 250,
  "startup_timeout_seconds": 3600.0,
  "shutdown_timeout_seconds": 180.0,
  "acceptable_exit_codes": [0, 143]
}
