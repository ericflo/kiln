{
  "schema": "kiln.serving-benchmark-server-launch.v1",
  "id": "vllm-rocm-strix-halo-triton-text-v2",
  "command": [
    "./.qualification/vllm-rocm-venv/bin/python-kiln",
    "scripts/vllm_teacher.py",
    "--model-path=Qwen3.5-4B",
    "--snapshot-root=.qualification/vllm-teacher-snapshots",
    "--served-model-id=Qwen3.5-4B",
    "--process-group-mode=inherited",
    "--max-top-k=20",
    "--max-model-len=32768",
    "--",
    "--host=127.0.0.1",
    "--port=8421",
    "--dtype=bfloat16",
    "--gpu-memory-utilization=0.4",
    "--max-num-seqs=64",
    "--max-num-batched-tokens=32768",
    "--attention-backend=TRITON_ATTN",
    "--kv-cache-dtype=auto",
    "--block-size=16",
    "--seed=0",
    "--scheduling-policy=fcfs",
    "--enable-prefix-caching",
    "--disable-custom-all-reduce",
    "--disable-uvicorn-access-log",
    "--disable-log-stats",
    "--language-model-only"
  ],
  "working_directory": "../..",
  "log_directory": "../../.qualification/vllm-serving/logs",
  "readiness_poll_interval_ms": 250,
  "startup_timeout_seconds": 1200.0,
  "shutdown_timeout_seconds": 180.0,
  "acceptable_exit_codes": [0, 143]
}
