{
  "schema_version": 1,
  "workload_id": "serving-vulkan-development-soak-v1",
  "kind": "soak",
  "description": "Keep one Vulkan server process under mixed streaming load for at least 30 minutes and fail on late faults, unexplained ITL gaps, leaked KV blocks, graph activity, host-memory pressure, swap growth, or post-warm memory growth.",
  "determinism": {
    "seed": 20260715,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "vulkan-development-soak",
      "description": "Graph-disabled Vulkan development soak with fixed KV capacity and allocator reclaim disabled, bounded concurrency, periodic cancellation, and a fail-closed host-memory guard.",
      "backend": "vulkan",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_jobs": 1,
          "cargo_execution_mode": "transient-service",
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 15,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "vulkan",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "timeout_seconds": 900
        },
        "runtime": {
          "serving_profile": "experimental",
          "kv_autoscale_requested": false,
          "kv_autoscale_enabled": false,
          "memory_reclaim_requested_mode": "off",
          "memory_reclaim_mode": "off",
          "rocm_graphs_requested": false,
          "rocm_graphs_enabled": false
        },
        "server": {
          "chat_performance_metadata_enabled": true,
          "debug_endpoints_enabled": true,
          "default_thinking_enabled": false,
          "http_send_buffer_bytes": 4096,
          "log_format": "json",
          "request_timeout_seconds": 600,
          "stream_stall_grace_ms": 2000,
          "max_decode_batch": 8,
          "max_prefill_staging_slots": 4,
          "max_active_requests": 12,
          "max_prefill_staging_priority_burst": 4,
          "max_prefill_tokens_per_cycle": 64,
          "max_prefill_layers_per_cycle": 4
        },
        "soak": {
          "cancellation_after_semantic_deltas": 4,
          "cancellation_max_tokens": 256,
          "cancellation_prompt_words": 48,
          "cancel_every_waves": 4,
          "gpu_memory_scope": "server_process",
          "gpu_memory_source": "linux_proc_drm_fdinfo:vram+gtt+cpu",
          "active_gpu_peak_growth_limit_bytes": 1073741824,
          "max_tokens": 16,
          "rocm_graph_cache_entries": 12,
          "memory_growth_limit_bytes": 536870912,
          "minimum_duration_seconds": 1800.0,
          "outlier_absolute_ms": 250,
          "outlier_history_size": 64,
          "outlier_multiplier": 5,
          "prompt_identity": "fixed_by_slot_measured_unique_by_epoch_warmup",
          "prompt_words": {
            "slot_0": 16,
            "slot_1": 32,
            "slot_2": 64,
            "slot_3": 96,
            "slot_4": 128,
            "slot_5": 192,
            "slot_6": 256,
            "slot_7": 384
          },
          "request_ignore_eos": true,
          "setup_deadline_seconds": 1800,
          "stabilization_gpu_delta_limit_bytes": 67108864,
          "stabilization_memory_boundary": "process_drm_and_owned_buffers",
          "stabilization_max_cycles": 8,
          "stabilization_min_cycles": 4,
          "stabilization_required_stable_cycles": 2,
          "stabilization_rss_delta_limit_bytes": null,
          "stabilization_rss_growth_limit_bytes": 536870912,
          "steady_state_warmup_max_waves": 12,
          "vulkan_buffer_pool_gb": 3.0,
          "wave_concurrency": {
            "wave_0": 1,
            "wave_1": 4,
            "wave_2": 8,
            "wave_3": 4
          },
          "host_mem_available_floor_bytes": 8589934592,
          "host_swap_growth_limit_bytes": 536870912,
          "host_memory_poll_interval_ms": 250
        }
      },
      "cases": [
        {
          "id": "continuous-mixed-load",
          "description": "Build current Vulkan source once, retain one server process, and run mixed fixed-output waves with periodic cancellation for at least 30 minutes.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_development_soak.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}",
            "--minimum-duration-seconds",
            "1800",
            "--memory-growth-limit-bytes",
            "536870912"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1"
          },
          "timeout_seconds": 4200,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no vulkan device|skipp(?:ed|ing).*(?:vulkan|physical device))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "command",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": [
              "attributed_itl_outlier_count",
              "batching_error_count",
              "batching_max_observed_active_requests",
              "batching_max_observed_batch_size",
              "cancellation_confirmed_count",
              "completion_token_count",
              "device_fault_event_count",
              "external_yield_sync_failure_count",
              "external_yield_sync_max_ms",
              "external_yield_sync_slow_count",
              "gpu_memory_baseline_bytes",
              "gpu_memory_end_bytes",
              "gpu_memory_growth_bytes",
              "gpu_memory_peak_bytes",
              "gpu_memory_peak_growth_bytes",
              "graph_capture_failure_count",
              "graph_capture_success_count",
              "graph_fallback_count",
              "graph_replay_failure_count",
              "graph_replay_success_count",
              "graph_retained_count_end",
              "graph_retained_count_start",
              "graph_slot_active_count_end",
              "graph_slot_count_end",
              "graph_slot_count_start",
              "graph_slot_create_count",
              "graph_slot_idle_count_end",
              "graph_slot_reuse_count",
              "host_mem_available_end_bytes",
              "host_mem_available_min_bytes",
              "host_mem_available_start_bytes",
              "host_memory_guard_trip_count",
              "host_swap_growth_bytes",
              "host_swap_used_end_bytes",
              "host_swap_used_peak_bytes",
              "host_swap_used_start_bytes",
              "itl_ms_p50",
              "itl_ms_p99",
              "itl_ms_p999",
              "kv_blocks_end",
              "kv_blocks_start",
              "kv_blocks_used_end",
              "kv_unaccounted_blocks_end",
              "non_finite_response_count",
              "prefix_cache_active_leases_end",
              "prefix_cache_baseline_cached_entries",
              "prefix_cache_baseline_state_bytes",
              "prefix_cache_cached_blocks_end",
              "prefix_cache_cached_entries_end",
              "prefix_cache_hit_blocks",
              "prefix_cache_hit_tokens",
              "prefix_cache_lookup_hit_count",
              "prefix_cache_lookup_miss_count",
              "prefix_cache_pending_release_entries_end",
              "prefix_cache_state_bytes_end",
              "prompt_tokens_max",
              "prompt_tokens_min",
              "request_count",
              "request_failure_count",
              "rss_baseline_bytes",
              "rss_end_bytes",
              "rss_growth_bytes",
              "rss_peak_bytes",
              "shutdown_forced_count",
              "shutdown_nonzero_count",
              "snapshot_residue_count",
              "soak_duration_seconds",
              "stabilization_cancellation_count",
              "stabilization_cycle_count",
              "stabilization_final_gpu_delta_bytes",
              "stabilization_final_rss_delta_bytes",
            "stabilization_max_gpu_delta_bytes",
            "stabilization_max_rss_delta_bytes",
            "stabilization_request_count",
            "stabilization_rss_growth_bytes",
            "stabilization_stable_cycle_count",
              "steady_state_warmup_request_count",
              "steady_state_warmup_wave_count",
              "ttft_ms_p50",
              "ttft_ms_p99",
              "ttft_ms_p999",
              "unexplained_itl_outlier_count",
              "vulkan_buffer_allocated_bytes",
              "vulkan_buffer_allocation_count",
              "vulkan_buffer_free_count",
              "vulkan_buffer_freed_bytes",
              "vulkan_buffer_live_bytes_end",
              "vulkan_buffer_live_bytes_growth",
            "vulkan_buffer_live_bytes_start",
            "vulkan_buffer_peak_live_bytes",
            "vulkan_buffer_pool_cache_hit_count",
            "vulkan_buffer_pool_cache_miss_count",
            "vulkan_buffer_pool_evicted_bytes",
            "vulkan_buffer_pool_eviction_count",
            "vulkan_buffer_pool_limit_bytes",
            "vulkan_buffer_pool_retained_bytes_end",
            "vulkan_buffer_pool_retained_bytes_growth",
            "vulkan_buffer_pool_retained_bytes_start",
            "vulkan_buffer_pool_uncached_allocated_bytes",
            "vulkan_buffer_pool_uncached_allocation_count",
            "vulkan_buffer_stabilization_growth_cycle_count",
            "wave_count",
              "zero_token_response_count"
            ]
          }
        }
      ]
    }
  ],
  "comparison_policy": null
}
