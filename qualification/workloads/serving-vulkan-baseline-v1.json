{
  "schema_version": 1,
  "workload_id": "serving-vulkan-baseline-v1",
  "kind": "performance",
  "description": "Build one source-bound Vulkan server and run synchronized 1/4/8/12-request waves with exact runtime identity, batching, pause, memory, and lifecycle evidence.",
  "determinism": {
    "seed": 20260713,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "vulkan-serving-baseline",
      "description": "Exercise fixed-output Vulkan serving from single-request latency through twelve-request saturation on one immutable binary and typed config.",
      "backend": "vulkan",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_jobs": 1,
          "cargo_cpu_quota_percent": 50,
          "cargo_execution_mode": "transient-service",
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_host_thermal_limit_millicelsius": 97000,
          "cargo_host_thermal_poll_milliseconds": 250,
          "cargo_host_thermal_sensor_label": "Tctl",
          "cargo_host_thermal_sensor_name": "k10temp",
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 15,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "vulkan",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "timeout_seconds": 900
        },
        "runtime": {
          "serving_profile": "experimental",
          "kv_autoscale_requested": false,
          "kv_autoscale_enabled": false,
          "memory_reclaim_requested_mode": "off",
          "memory_reclaim_mode": "off",
          "rocm_graphs_requested": false,
          "rocm_graphs_enabled": false
        },
        "server": {
          "chat_performance_metadata_enabled": true,
          "debug_model_state": true,
          "default_thinking_enabled": false,
          "http_send_buffer_bytes": 4096,
          "log_format": "json",
          "request_timeout_seconds": 600,
          "stream_stall_grace_ms": 2000,
          "max_decode_batch": 8,
          "max_prefill_staging_slots": 4,
          "max_active_requests": 12,
          "max_prefill_staging_priority_burst": 4,
          "max_prefill_tokens_per_cycle": 64,
          "max_prefill_layers_per_cycle": 4
        },
        "model": {
          "vulkan_decode_weight_prewarm": true,
          "vulkan_decode_weight_prewarm_mib_per_second": 256
        },
        "workload": {
          "expected_completion_tokens": 800,
          "expected_finish_reason": "length",
          "expected_request_count": 25,
          "ignore_eos": true,
          "max_tokens": 32,
          "overall_timeout_seconds": 1800,
          "pause_gate_ms": 2000,
          "request_timeout_seconds": 600,
          "semantic_output_evidence": "ordered_canonical_sha256",
          "simultaneous_dispatch": "per_wave_thread_barrier",
          "stall_evidence_ms": 250,
          "warmup_max_tokens": 16,
          "waves": {
            "single": {
              "slot_0": 16
            },
            "batch-4": {
              "slot_0": 16,
              "slot_1": 64,
              "slot_2": 192,
              "slot_3": 384
            },
            "batch-8": {
              "slot_0": 16,
              "slot_1": 32,
              "slot_2": 64,
              "slot_3": 96,
              "slot_4": 192,
              "slot_5": 384,
              "slot_6": 512,
              "slot_7": 768
            },
            "saturation-12": {
              "slot_0": 16,
              "slot_1": 24,
              "slot_2": 32,
              "slot_3": 48,
              "slot_4": 64,
              "slot_5": 96,
              "slot_6": 128,
              "slot_7": 192,
              "slot_8": 256,
              "slot_9": 384,
              "slot_10": 512,
              "slot_11": 1024
            }
          }
        }
      },
      "cases": [
        {
          "id": "vulkan-serving-baseline",
          "description": "Require a real Vulkan execution identity, exact fixed outputs, multi-row batching, no device faults or runtime mutation, no two-second ITL pause, and clean teardown.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_vulkan_baseline.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1"
          },
          "timeout_seconds": 2100,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no vulkan device|skipp(?:ed|ing).*vulkan|falling back to cpu)"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "command",
