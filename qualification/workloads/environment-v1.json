{
  "schema_version": 1,
  "workload_id": "local-environment-v1",
  "kind": "environment",
  "description": "Capture a strict local accelerator environment receipt without network access.",
  "determinism": {
    "seed": null,
    "seed_delivery": "not_applicable",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [
    {
      "name": "host_id",
      "description": "Stable non-secret identifier for the physical qualification host.",
      "type": "string",
      "required": true,
      "default": null,
      "constraints": {
        "allowed_values": [],
        "minimum": null,
        "maximum": null,
        "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
      }
    },
    {
      "name": "output_path",
      "description": "Ignored local path where the environment collector writes its receipt.",
      "type": "string",
      "required": true,
      "default": null,
      "constraints": {
        "allowed_values": [],
        "minimum": null,
        "maximum": null,
        "pattern": "^\\.qualification/[a-z0-9_-]+(?:/[a-z0-9_-]+)*\\.json$"
      }
    }
  ],
  "variants": [
    {
      "id": "cuda-rtx4090-desktop-24gb",
      "description": "Collect the selected 24 GB NVIDIA GeForce RTX 4090, CUDA driver/toolkit, compiler, and capture-time memory capability.",
      "backend": "cuda",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {},
      "cases": [
        {
          "id": "environment-capture",
          "description": "Run the strict CUDA environment collector for the 24 GB desktop device class.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/environment.py",
            "--backend",
            "cuda",
            "--host-id",
            "${host_id}",
            "--output",
            "${output_path}",
            "--device-index",
            "0",
            "--expected-device-name-regex",
            "^NVIDIA GeForce RTX 4090$",
            "--minimum-memory-mib",
            "23000",
            "--maximum-memory-mib",
            "25000"
          ],
          "working_directory": ".",
          "environment": {},
          "timeout_seconds": 120,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": [
              "case_pass",
              "exit_code",
              "output_assertion_failures"
            ]
          }
        }
