              "concurrency_32_request_count",
              "concurrency_32_ttft_ms_p99",
              "concurrency_64_e2e_ms_p99",
              "concurrency_64_itl_ms_p99",
              "concurrency_64_request_count",
              "concurrency_64_ttft_ms_p99",
              "concurrency_8_e2e_ms_p99",
              "concurrency_8_itl_ms_p99",
              "concurrency_8_request_count",
              "concurrency_8_ttft_ms_p99",
              "graph_budget_event_count",
              "headroom_graph_capture_count",
              "headroom_graph_failure_count",
              "headroom_graph_peak_retained_bytes",
              "headroom_graph_replay_count",
              "headroom_peak_gpu_memory_used_bytes",
              "max_completed_concurrency",
              "output_mismatch_count",
              "request_failure_count",
