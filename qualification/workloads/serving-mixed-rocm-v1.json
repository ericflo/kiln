{
  "schema_version": 1,
  "workload_id": "serving-mixed-rocm-v1",
  "kind": "performance",
  "description": "Measure deterministic mixed streaming load, long prefill, cancellation, and slow-consumer behavior on a required ROCm device.",
  "determinism": {
    "seed": 20260709,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "autoscale-off",
      "description": "KV-autoscale-off arm; resize attribution remains observational unless the default arm records a resize.",
      "backend": "rocm",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "features": "rocm",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "rocm_archs": "gfx1151",
          "rocm_path": "/opt/rocm"
        },
        "runtime": {
          "serving_profile": "experimental",
          "kv_autoscale_requested": false,
          "kv_autoscale_enabled": false,
          "memory_reclaim_requested_mode": "off",
          "memory_reclaim_mode": "off",
          "rocm_graphs_requested": true,
          "rocm_graphs_enabled": true
        },
        "server": {
          "chat_performance_metadata_enabled": true,
          "debug_endpoints_enabled": true,
          "default_thinking_enabled": false,
          "http_send_buffer_bytes": 4096,
          "log_format": "json",
          "request_timeout_seconds": 180,
          "stream_stall_grace_ms": 2000,
          "max_prefill_tokens_per_cycle": 64,
          "max_prefill_layers_per_cycle": 4
        },
        "workload": {
          "cancellation_after_semantic_deltas": 4,
          "long_prefill_max_tokens": 32,
          "long_prefill_words": 1536,
          "max_warmup_requests": 4,
          "measured_expected_completion_tokens": 1184,
          "measured_finish_reason": "length",
          "measured_ignore_eos": true,
          "memory_poll_interval_ms": 500,
          "normal_max_tokens": 128,
          "normal_requests": 8,
          "outlier_absolute_ms": 250,
          "outlier_history_size": 64,
          "outlier_multiplier": 5,
          "overall_timeout_seconds": 420,
          "pressure_peer_dispatch": "after_slow_headers_before_pressure_wait",
          "pressure_peer_max_tokens": 128,
          "pressure_peer_prompt_words": 64,
          "pressure_peer_seed_offset": 103,
          "prompt_identity": "variant_invariant_fixed_output_v2",
          "prompt_marker_format": "QUAL-{seed}-{role}",
          "request_timeout_seconds": 120,
          "slow_socket_buffer_bytes": 4096,
          "slow_max_tokens": 4096,
          "startup_timeout_seconds": 240,
          "warmup_max_tokens": 32
        }
      },
      "cases": [
        {
          "id": "mixed-load",
          "description": "Build current source and run qualification-grade mixed SSE traffic with cancellation and socket backpressure.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_mixed_load.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1",
            "ROCM_PATH": "/opt/rocm"
          },
          "timeout_seconds": 900,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no rocm device|skipp(?:ed|ing).*rocm)"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "command",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": [
              "attributed_itl_outlier_count",
              "batching_admission_call_count",
