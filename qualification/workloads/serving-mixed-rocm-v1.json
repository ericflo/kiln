              "kv_resize_event_count",
              "length_terminated_request_count",
              "long_prefill_prompt_tokens",
              "memory_reclaim_event_count",
              "output_token_throughput_per_second",
              "peak_gpu_memory_used_bytes",
              "pressure_peer_first_ready_after_dispatch_ms",
              "pressure_peer_ready_after_count",
              "pressure_peer_ready_before_count",
              "pressure_peer_ready_inside_count",
              "pressure_window_duration_ms",
              "pressure_window_start_after_peer_dispatch_ms",
              "prompt_token_count",
              "request_count",
              "request_failure_count",
              "request_throughput_per_second",
              "response_queue_delay_ms_p50",
              "response_queue_delay_ms_p99",
              "response_queue_delay_ms_p999",
              "slo_goodput_requests_per_second",
              "slow_consumer_peer_success_count",
              "ttft_ms_p50",
