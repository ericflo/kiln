{
  "schema_version": 1,
  "workload_id": "serving-backend-regression-closure-v1",
  "kind": "correctness",
  "description": "Run a bounded two-request current-source serving closure over a fixed KV pool, requiring exact output, live decode growth, backend-qualified prefix-cache behavior, and clean teardown.",
  "determinism": {
    "seed": 20260728,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "rocm-kv-prefix-closure",
      "description": "Prime unleased ROCm prefix state, then require exact output while live decode growth reclaims it from a fixed 32-block KV pool.",
      "backend": "rocm",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_execution_mode": "transient-service",
          "cargo_jobs": 1,
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 1,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "rocm",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "rocm_path": "/opt/rocm",
          "timeout_seconds": 900
        },
        "memory": {
          "kv_autoscale": false,
          "num_blocks": 32,
          "reclaim_mode": "off"
        },
        "model": {
          "accelerator_weight_upload_mib_per_second": 256,
          "checkpoint_read_mib_per_second": 256
        },
        "prefix_cache": {
          "effective_enabled": true,
          "max_blocks": 16,
          "max_entries": 4,
          "requested_enabled": true
        },
        "runtime": {
          "kv_autoscale_enabled": false,
          "kv_autoscale_requested": false,
          "memory_reclaim_mode": "off",
          "memory_reclaim_requested_mode": "off",
          "prefix_cache_effective_enabled": true,
          "prefix_cache_effective_reason": "active",
          "prefix_cache_requested_enabled": true,
          "rocm_graphs_enabled": false,
          "rocm_graphs_requested": false,
          "serving_profile": "experimental"
        },
        "server": {
          "chat_performance_metadata_enabled": true,
          "debug_model_state": true,
          "default_thinking_enabled": false,
          "http_send_buffer_bytes": 4096,
          "log_format": "json",
          "max_active_requests": 1,
          "max_batch_tokens": 512,
          "max_decode_batch": 1,
          "max_prefill_layers_per_cycle": 4,
          "max_prefill_staging_priority_burst": 0,
          "max_prefill_staging_slots": 0,
          "max_prefill_tokens_per_cycle": 256,
          "request_timeout_seconds": 600,
          "stream_stall_grace_ms": 2000
        },
        "workload": {
          "expected_completion_tokens": 272,
          "expected_finish_reason": "length",
          "expected_request_count": 2,
          "kv_block_size": 16,
          "kv_num_blocks": 32,
          "overall_timeout_seconds": 1800,
          "prefix_cache_max_blocks": 16,
          "prefix_cache_max_entries": 4,
          "pressure_max_tokens": 256,
          "prime_max_tokens": 16,
          "prompt_words": 48,
          "request_timeout_seconds": 600,
          "response_oracle": "ascending_zero_padded_integers_prefix_v1",
          "sequence": "prime_then_pressure"
        }
      },
      "cases": [
        {
          "id": "rocm-serving-regression-closure",
          "description": "Build current source, prime unleased prefix state, cross sixteen decode-growth block boundaries with exact output, require structured reclamation, and prove bounded cleanup.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_backend_regression_closure.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1",
            "ROCM_PATH": "/opt/rocm"
          },
          "timeout_seconds": 2100,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no rocm device|rocm (?:device )?(?:is )?(?:not available|unavailable)|skipp(?:ed|ing)[^\\r\\n]{0,160}rocm (?:device|test|hardware))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
