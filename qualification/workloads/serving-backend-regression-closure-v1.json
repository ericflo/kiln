              "prefix_cache_cached_blocks_end",
              "prefix_cache_enabled",
              "prefix_cache_lookup_miss_count",
              "prefix_cache_pending_release_entries_end",
              "prefix_cache_reclaim_event_count",
              "prefix_cache_reclaimed_block_count",
              "prefix_cache_state_bytes_end",
              "pressure_completion_token_count",
              "pressure_prompt_token_count",
              "request_count",
