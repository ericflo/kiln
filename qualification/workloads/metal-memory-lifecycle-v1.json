            "--locked",
            "--offline",
            "-p",
            "kiln-server",
            "--no-default-features",
            "--features",
            "metal",
            "--lib",
            "state::tests::metal_allocator_failure_retries_on_real_device_and_cleans_up",
            "--",
            "--exact",
            "--ignored",
            "--nocapture",
            "--test-threads=1"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "KILN_QUALIFICATION": "1"
          },
          "timeout_seconds": 1800,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "\\[metal-allocation-failure\\] OK: injected first allocator failure; fallback allocated real Metal cache and cleanup returned near baseline"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(skip.*metal|no Metal device|test result: FAILED)"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
        {
