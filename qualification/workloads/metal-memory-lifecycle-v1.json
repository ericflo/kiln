{
  "schema_version": 1,
  "workload_id": "metal-memory-lifecycle-v1",
  "kind": "correctness",
  "description": "Run fail-closed Apple unified-memory admission, controlled allocation-failure recovery, ownership-release reclaim, and runner-owned process cleanup gates on the named M1 MacBook Air.",
  "determinism": {
    "seed": 20260728,
