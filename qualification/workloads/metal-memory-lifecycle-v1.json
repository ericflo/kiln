  },
  "variables": [],
  "variants": [
    {
      "id": "metal-m1-macbook-air",
      "description": "Require the selected eight-core Apple M1 GPU and prove the server's bounded memory lifecycle against live unified-memory observations.",
      "backend": "metal",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {},
      "cases": [
        {
          "id": "device-probe",
          "description": "Require system_profiler to report the Apple M1 GPU and its eight GPU cores.",
          "required": true,
          "command": [
            "system_profiler",
            "SPDisplaysDataType",
            "-json"
          ],
          "working_directory": ".",
          "environment": {},
          "timeout_seconds": 120,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "\"(?:sppci_model|_name)\"\\s*:\\s*\"Apple M1\""
            },
            {
              "stream": "combined",
              "match": "required",
              "pattern": "\"(?:sppci_cores|spdisplays_gpu_cores)\"\\s*:\\s*\"?8(?: Cores)?\"?"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no Metal device|skipp(?:ed|ing))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
        {
          "id": "server-admission-rejection",
          "description": "Use the live Apple unified-memory snapshot with a controlled low available-memory budget and require the server's exact paged-KV gate to reject before Metal allocation.",
          "required": true,
          "command": [
            "scripts/qualification/cargo-test-bounded.sh",
            "test",
            "--locked",
            "--offline",
            "-p",
            "kiln-server",
            "--no-default-features",
            "--features",
            "metal",
            "--lib",
            "state::tests::metal_unified_memory_admission_rejects_before_allocation",
            "--",
            "--exact",
            "--ignored",
            "--nocapture",
            "--test-threads=1"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "KILN_QUALIFICATION": "1"
          },
          "timeout_seconds": 1800,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "\\[metal-admission\\] OK: controlled UMA budget rejected num_blocks=[0-9]+ before allocation"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(skip.*metal|no Metal device|test result: FAILED|out of memory)"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
