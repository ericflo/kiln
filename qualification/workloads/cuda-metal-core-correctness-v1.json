{
  "schema_version": 1,
  "workload_id": "cuda-metal-core-correctness-v1",
  "kind": "correctness",
  "description": "Run fail-closed CUDA or Metal device, tensor, dense-matmul, graph-replay, SFT-step, and pinned PyTorch AdamW oracle gates on the named handoff machines.",
  "determinism": {
    "seed": 20260721,
    "seed_delivery": "fixed_fixture",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "cuda-rtx4090-desktop-24gb",
      "description": "Require the selected desktop RTX 4090 and execute bounded CUDA substrate, matmul, training-step, and optimizer-oracle cases.",
      "backend": "cuda",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {},
      "cases": [
        {
          "id": "device-probe",
          "description": "Require CUDA logical device zero to be the desktop NVIDIA GeForce RTX 4090 selected by the preceding environment receipt.",
          "required": true,
          "command": [
            "nvidia-smi",
            "-i",
            "0",
            "--query-gpu=name",
            "--format=csv,noheader"
          ],
          "working_directory": ".",
          "environment": {},
          "timeout_seconds": 60,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "(?m)^NVIDIA GeForce RTX 4090\\s*$"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no devices were found|skipp(?:ed|ing))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
        {
          "id": "tensor-parity",
          "description": "Exercise CUDA allocation, device copies, compact views, prefix writes, and synchronization across shrink- and grow-shaped buffers.",
          "required": true,
          "command": [
            "scripts/qualification/cargo-test-bounded.sh",
            "test",
            "--locked",
            "--offline",
            "-p",
            "kiln-tensor",
            "--no-default-features",
            "--features",
            "cuda",
            "--test",
            "cuda_resize_copy_primitives",
            "--",
            "--nocapture",
            "--test-threads=1"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "CUDARC_CUDA_VERSION": "12080",
            "KILN_CUDA_ARCHS": "89",
            "KILN_QUALIFICATION": "1"
          },
          "timeout_seconds": 1800,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "\\[cuda-primitives\\] OK"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(skip.*cuda|no CUDA device|test result: FAILED)"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
        {
