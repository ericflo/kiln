              "width_8_host_temperature_peak_millicelsius",
              "width_8_itl_ms_p99",
              "width_8_max_observed_decode_batch",
              "width_8_peak_gpu_memory_used_bytes",
              "width_8_request_failure_count",
              "width_8_sampled_fused_dispatch_count",
              "width_8_sampled_fused_failure_count",
              "width_8_sampled_fused_max_batch_rows",
              "width_8_sampled_fused_row_count",
              "width_8_sampled_max_observed_decode_batch",
