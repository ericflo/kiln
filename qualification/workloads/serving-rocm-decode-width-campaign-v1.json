{
  "schema_version": 1,
  "workload_id": "serving-rocm-decode-width-campaign-v1",
  "kind": "performance",
  "description": "Select the narrowest correctness-qualified Strix Halo ROCm decode width near the best deterministic and fused-sampled throughput without blind cap increases.",
  "determinism": {
    "seed": 20260720,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "rocm",
      "description": "Run widths 2, 4, and 8 serially against one source-built binary with a guarded cooldown and restart between arms.",
      "backend": "rocm",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_cpu_quota_percent": 50,
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_execution_mode": "transient-service",
          "cargo_host_thermal_limit_millicelsius": 97000,
          "cargo_host_thermal_poll_milliseconds": 250,
          "cargo_host_thermal_sensor_label": "Tctl",
          "cargo_host_thermal_sensor_name": "k10temp",
          "cargo_jobs": 1,
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 15,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "rocm",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "rocm_archs": "gfx1151",
          "rocm_path": "/opt/rocm",
          "timeout_seconds": 900
        },
        "candidate_policy": {
          "baseline_width": 2,
          "candidate_widths": {
            "width_2": 2,
            "width_4": 4,
            "width_8": 8
          },
          "max_active_requests_formula": "decode_width + prefill_staging_slots",
          "prefill_staging_slots_formula": "min(decode_width, 4) when decode_width > 1, otherwise 0"
        },
        "selection": {
          "max_peak_gpu_memory_growth_bytes": 1073741824,
          "max_tail_regression_percent": 25.0,
          "min_promotion_improvement_percent": 3.0,
          "objective": "maximize the minimum deterministic/sample throughput ratio to width 2, then choose the narrowest width within the tie band",
          "throughput_tie_percent": 2.0
        },
        "shared_candidate_config": {
          "batching": {
            "actor_cycle_idle_ms": 50
          },
          "host_safety": {
            "thermal_cooldown": {
              "mode": "post_process_exit_consecutive_samples",
              "poll_interval_ms": 250,
              "scope": "host_package",
              "stable_samples": 8,
              "target_millicelsius": 75000,
              "timeout_seconds": 180.0
            },
            "thermal_guard": {
              "limit_millicelsius": 97000,
              "poll_interval_ms": 250,
              "sensor": {
                "hwmon_name": "k10temp",
                "label": "Tctl"
              }
            }
          },
          "model": {
            "accelerator_weight_upload_mib_per_second": 256,
            "checkpoint_read_mib_per_second": 256
          },
          "runtime": {
            "kv_autoscale_enabled": false,
            "kv_autoscale_requested": false,
            "memory_reclaim_mode": "off",
            "memory_reclaim_requested_mode": "off",
            "prefix_cache_effective_enabled": true,
            "prefix_cache_effective_reason": "active",
            "prefix_cache_requested_enabled": true,
            "rocm_graphs_enabled": true,
            "rocm_graphs_requested": true,
            "serving_profile": "experimental"
          },
          "server": {
            "chat_performance_metadata_enabled": true,
            "debug_model_state": true,
            "default_thinking_enabled": false,
            "http_send_buffer_bytes": 4096,
            "log_format": "json",
            "max_batch_tokens": 512,
            "max_prefill_layers_per_cycle": 8,
            "max_prefill_tokens_per_cycle": 256,
            "request_timeout_seconds": 180,
            "stream_stall_grace_ms": 2000
          },
          "workload": {
            "cancellation_after_semantic_deltas": 4,
            "delivery_pressure_timeout_seconds": 90,
            "long_prefill_marker_role": "long-prefill",
            "long_prefill_max_tokens": 32,
            "long_prefill_words": 1536,
            "max_warmup_requests": 4,
            "measured_expected_completion_tokens": 1312,
            "measured_finish_reason": "length",
            "measured_ignore_eos": true,
            "memory_poll_interval_ms": 500,
            "normal_max_tokens": 128,
            "normal_requests": 8,
            "outlier_absolute_ms": 250,
            "outlier_history_size": 64,
            "outlier_multiplier": 5,
            "overall_timeout_seconds": 1200,
            "pressure_peer_dispatch": "before_slow_start_after_first_token",
            "pressure_peer_max_tokens": 256,
            "pressure_peer_prompt_words": 64,
            "pressure_peer_seed_offset": 103,
            "prompt_identity": "variant_invariant_fixed_output_v5",
            "prompt_marker_format": "QUAL-{seed}-{role}",
            "request_timeout_seconds": 180,
            "response_oracle": "ascending_zero_padded_integers_prefix_v1",
            "response_oracle_integer_width": 6,
            "response_oracle_target_integer_count": 64,
            "rocm_w8_lm_head_route_evidence": "health_counter_delta_v1",
            "sampled_profile_max_tokens": 32,
            "sampled_profile_min_p": 0.0,
            "sampled_profile_order": "after_measured_deterministic_window",
            "sampled_profile_post_determinism_canary": "exact_replay_of_normal_00_v1",
            "sampled_profile_prompt_words": 64,
            "sampled_profile_requests": 8,
            "sampled_profile_seed_offset": 1000,
            "sampled_profile_temperature": 0.7,
            "sampled_profile_top_k": 40,
            "sampled_profile_top_p": 0.9,
            "slow_max_tokens": 4096,
            "slow_response_target_integer_count": 1024,
            "slow_socket_buffer_bytes": 4096,
            "startup_timeout_seconds": 240,
            "warmup_max_tokens": 32
          }
        }
      },
      "cases": [
        {
          "id": "rocm-decode-width-campaign",
          "description": "Build once, execute guarded mixed deterministic and sampled traffic at each candidate width, require exact width formation and graph/fused route correctness, and apply the conservative selector.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_rocm_decode_width_campaign.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1",
            "ROCM_PATH": "/opt/rocm"
          },
          "timeout_seconds": 4500,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no rocm device|rocm (?:device )?(?:is )?(?:not available|unavailable)|skipp(?:ed|ing)[^\\r\\n]{0,160}rocm (?:device|test|hardware))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "command",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": [
              "candidate_count",
              "candidate_failure_count",
              "candidate_not_run_count",
              "candidate_pass_count",
              "selected_decode_width",
              "selected_min_throughput_improvement_percent",
              "selected_score_ratio",
              "source_build_seconds",
              "width_2_correctness_passed",
              "width_2_deterministic_output_tokens_per_second",
              "width_2_e2e_ms_p99",
              "width_2_external_yield_sync_failure_count",
              "width_2_graph_capture_failure_count",
              "width_2_graph_capture_success_count",
              "width_2_graph_replay_failure_count",
              "width_2_graph_replay_success_count",
              "width_2_host_temperature_peak_millicelsius",
              "width_2_itl_ms_p99",
              "width_2_max_observed_decode_batch",
              "width_2_peak_gpu_memory_used_bytes",
              "width_2_request_failure_count",
              "width_2_sampled_fused_dispatch_count",
              "width_2_sampled_fused_failure_count",
              "width_2_sampled_fused_max_batch_rows",
              "width_2_sampled_fused_row_count",
