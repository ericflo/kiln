              "width_8_unexplained_itl_outlier_count"
            ]
          }
        }
      ]
    }
  ],
  "comparison_policy": {
    "mode": "same_environment_performance",
    "variant_pairs": [],
    "backend_pairs": [],
    "metric_rules": [
      {
        "scope": "result",
        "result_id": "rocm-decode-width-campaign",
        "metric": "candidate_count",
        "metric_class": "performance",
        "unit": "count",
        "aggregation": "exact",
        "lower_is_better": false,
        "operator": "equal",
