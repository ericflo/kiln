              "width_4_graph_replay_success_count",
              "width_4_host_temperature_peak_millicelsius",
              "width_4_itl_ms_p99",
              "width_4_max_observed_decode_batch",
              "width_4_peak_gpu_memory_used_bytes",
              "width_4_request_failure_count",
              "width_4_sampled_fused_dispatch_count",
              "width_4_sampled_fused_failure_count",
              "width_4_sampled_fused_max_batch_rows",
              "width_4_sampled_fused_row_count",
              "width_4_sampled_max_observed_decode_batch",
              "width_4_sampled_output_tokens_per_second",
              "width_4_score_ratio",
              "width_4_ttft_ms_p99",
              "width_4_unexplained_itl_outlier_count",
              "width_8_correctness_passed",
