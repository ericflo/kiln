{
  "schema_version": 1,
  "workload_id": "vulkan-inference-oracles-v1",
  "kind": "correctness",
  "description": "Prove source-pinned HF-derived Qwen tokenizer behavior, full-vocabulary resident/nonresident Qwen logit equivalence, and Vulkan argmax, stochastic sampling, selected-logprob, loss, and gradient parity against CPU/TRL oracles.",
  "determinism": {
    "seed": 20260715,
    "seed_delivery": "fixed_fixture",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "vulkan",
      "description": "Run fail-closed inference-oracle cases on a Vulkan device and source-pinned Qwen3.5-4B artifacts.",
      "backend": "vulkan",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {},
      "cases": [
        {
          "id": "device-probe",
          "description": "Require a concrete headless Vulkan physical device without mistaking skipped presentation-surface reporting for a device skip.",
          "required": true,
          "command": ["vulkaninfo", "--summary"],
          "working_directory": ".",
          "environment": {},
          "timeout_seconds": 60,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "(?m)^GPU[0-9]+:$"
            },
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no vulkan device|skipp(?:ed|ing).*(?:vulkan|physical device))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "runner",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": ["case_pass", "exit_code", "output_assertion_failures"]
          }
        },
        {
          "id": "argmax-cpu-oracle",
          "description": "Compare rows4 and rows8 BF16 fused linear argmax, including tail rows, to deterministic CPU matmul and tie-breaking expectations.",
          "required": true,
          "command": [
            "scripts/qualification/cargo-test-bounded.sh",
            "test",
            "--locked",
            "--offline",
            "-p",
            "kiln-vulkan-kernel",
            "--test",
            "linear_decode_argmax",
            "--",
            "--nocapture",
            "--test-threads=1"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "KILN_QUALIFICATION": "1"
          },
          "timeout_seconds": 1800,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "required",
              "pattern": "test result: ok\\. 2 passed; 0 failed; 0 ignored"
