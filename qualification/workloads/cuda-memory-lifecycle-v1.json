            "--test",
            "cuda_kv_physical_resize",
            "--",
            "--nocapture",
            "--test-threads=1"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "CUDARC_CUDA_VERSION": "12080",
            "KILN_CUDA_ARCHS": "89",
            "KILN_QUALIFICATION": "1"
          },
          "timeout_seconds": 1800,
          "expected_exit_codes": [0],
          "output_assertions": [
            {
              "stream": "combined",
