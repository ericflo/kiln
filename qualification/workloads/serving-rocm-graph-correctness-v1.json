{
  "schema_version": 1,
  "workload_id": "serving-rocm-graph-correctness-v1",
  "kind": "correctness",
  "description": "Compare full-model deterministic ROCm eager generation with warmed HIP-graph replay using exact public rollout action tokens and selected-token log-probabilities.",
  "determinism": {
    "seed": 20260713,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "eager-vs-warmed-graph",
      "description": "Sequential isolated deterministic eager and warmed-graph Qwen3.5-4B servers on ROCm.",
      "backend": "rocm",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_jobs": 1,
          "cargo_execution_mode": "transient-service",
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 1,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "rocm",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "timeout_seconds": 900,
          "rocm_path": "/opt/rocm"
        },
        "comparison": {
          "comparison": "exact_action_tokens_and_selected_logprobs",
          "graph_cache_entries": 12,
          "max_tokens": 48,
          "overall_timeout_seconds": 1800,
          "request_timeout_seconds": 240,
          "scenarios": {
            "short": 16,
            "medium": 96,
            "long": 384,
            "bucket-crossing": 768
          },
          "warm_then_measure": true
        },
        "eager": {
          "model": {
            "checkpoint_read_mib_per_second": 256,
            "accelerator_weight_upload_mib_per_second": 256
          },
          "runtime": {
            "serving_profile": "experimental",
            "kv_autoscale_requested": false,
            "kv_autoscale_enabled": false,
            "memory_reclaim_requested_mode": "off",
            "memory_reclaim_mode": "off",
            "rocm_graphs_requested": false,
            "rocm_graphs_enabled": false
          },
          "server": {
            "chat_performance_metadata_enabled": true,
            "debug_model_state": true,
            "default_thinking_enabled": false,
            "http_send_buffer_bytes": 4096,
            "log_format": "json",
            "request_timeout_seconds": 180,
            "stream_stall_grace_ms": 2000,
            "max_batch_tokens": 512,
            "max_decode_batch": 1,
            "max_prefill_staging_slots": 0,
            "max_active_requests": 1,
            "max_prefill_staging_priority_burst": 0,
            "max_prefill_tokens_per_cycle": 256,
            "max_prefill_layers_per_cycle": 4,
            "deterministic": true
          }
        },
        "graph": {
          "model": {
            "checkpoint_read_mib_per_second": 256,
            "accelerator_weight_upload_mib_per_second": 256
          },
          "runtime": {
            "serving_profile": "experimental",
            "kv_autoscale_requested": false,
            "kv_autoscale_enabled": false,
            "memory_reclaim_requested_mode": "off",
            "memory_reclaim_mode": "off",
            "rocm_graphs_requested": true,
            "rocm_graphs_enabled": true
          },
          "server": {
            "chat_performance_metadata_enabled": true,
            "debug_model_state": true,
            "default_thinking_enabled": false,
            "http_send_buffer_bytes": 4096,
            "log_format": "json",
            "request_timeout_seconds": 180,
            "stream_stall_grace_ms": 2000,
            "max_batch_tokens": 512,
            "max_decode_batch": 1,
            "max_prefill_staging_slots": 0,
            "max_active_requests": 1,
            "max_prefill_staging_priority_burst": 0,
            "max_prefill_tokens_per_cycle": 256,
            "max_prefill_layers_per_cycle": 4,
            "deterministic": true
          }
        }
      },
      "cases": [
        {
          "id": "rocm-eager-warmed-graph-correctness",
          "description": "Build current source once, warm fixed full-model graph geometries, and require exact repeat and eager-versus-replay action-token and behavior-logprob traces with clean teardown.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_rocm_graph_correctness.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1",
            "ROCM_PATH": "/opt/rocm"
          },
          "timeout_seconds": 2100,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no rocm device|rocm (?:device )?(?:is )?(?:not available|unavailable)|skipp(?:ed|ing)[^\\r\\n]{0,160}rocm (?:device|test|hardware))"
            }
          ],
          "result_protocol": {
            "format": "qualification-case-result-v1",
            "producer": "command",
            "path_environment_variable": "KILN_QUALIFICATION_CASE_RESULT",
            "declared_metrics": [
              "action_token_count",
              "behavior_logprob_mismatch_count",
              "eager_graph_activity_count",
              "eager_repeat_mismatch_count",
              "eager_request_count",
              "graph_capture_failure_count",
              "graph_capture_warm_count",
              "graph_fallback_count",
              "graph_measure_capture_count",
              "graph_measure_replay_count",
              "graph_repeat_mismatch_count",
              "graph_replay_failure_count",
              "graph_request_count",
              "graph_retained_count_end",
              "graph_slot_active_count_end",
              "graph_slot_count_end",
              "graph_slot_idle_count_end",
              "graph_slot_reuse_count",
              "non_finite_logprob_count",
              "output_mismatch_count",
              "prefix_cache_hit_count",
              "request_failure_count",
              "scenario_count",
              "shutdown_forced_count",
              "shutdown_nonzero_count",
              "snapshot_residue_count",
              "token_id_mismatch_count"
            ]
          }
        }
      ]
    }
  ],
  "comparison_policy": {
    "mode": "self_contained_correctness",
    "variant_pairs": [],
    "backend_pairs": [],
    "metric_rules": []
  }
}
