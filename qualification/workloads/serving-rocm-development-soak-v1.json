{
  "schema_version": 1,
  "workload_id": "serving-rocm-development-soak-v1",
  "kind": "soak",
  "description": "Keep one ROCm server process under mixed graph-backed streaming load for at least 30 minutes and fail on deterministic response corruption, late faults, unexplained ITL gaps, leaked KV blocks, or post-warm memory growth.",
  "determinism": {
    "seed": 20260712,
    "seed_delivery": "argv",
    "repetitions": 1,
    "case_order": "declared",
    "max_parallel_cases": 1,
    "network_access": "forbidden"
  },
  "variables": [],
  "variants": [
    {
      "id": "autoscale-off",
      "description": "Graph-on development soak with physical KV autoscaling and allocator reclaim disabled so graph and long-lived process behavior are isolated.",
      "backend": "rocm",
      "device_requirement": "required",
      "skip_policy": "fail",
      "effective_config": {
        "build": {
          "binary": "kiln",
          "cargo_jobs": 1,
          "cargo_cpu_quota_percent": 50,
          "cargo_execution_mode": "transient-service",
          "cargo_environment_policy": "closed-source-build-v1",
          "cargo_host_thermal_limit_millicelsius": 97000,
          "cargo_host_thermal_poll_milliseconds": 250,
          "cargo_host_thermal_sensor_label": "Tctl",
          "cargo_host_thermal_sensor_name": "k10temp",
          "cargo_memory_scope": "systemd_user_transient_service_memory_max_no_swap",
          "cargo_min_available_gib": 15,
          "cargo_private_network": true,
          "cargo_service_runtime_max_seconds": 840,
          "cargo_wrapper": "scripts/cargo-bounded.sh",
          "features": "rocm",
          "locked": true,
          "no_default_features": true,
          "offline": true,
          "package": "kiln-server",
          "profile": "release",
          "timeout_seconds": 900,
          "rocm_archs": "gfx1151",
          "rocm_path": "/opt/rocm"
        },
        "runtime": {
          "serving_profile": "experimental",
          "kv_autoscale_requested": false,
          "kv_autoscale_enabled": false,
          "memory_reclaim_requested_mode": "off",
          "memory_reclaim_mode": "off",
          "rocm_graphs_requested": true,
          "rocm_graphs_enabled": true,
          "prefix_cache_effective_enabled": true,
          "prefix_cache_effective_reason": "active",
          "prefix_cache_requested_enabled": true
        },
        "server": {
          "chat_performance_metadata_enabled": true,
          "debug_model_state": true,
          "default_thinking_enabled": false,
          "http_send_buffer_bytes": 4096,
          "log_format": "json",
          "request_timeout_seconds": 180,
          "stream_stall_grace_ms": 2000,
          "max_batch_tokens": 512,
          "max_decode_batch": 8,
          "max_prefill_staging_slots": 4,
          "max_active_requests": 12,
          "max_prefill_staging_priority_burst": 4,
          "max_prefill_tokens_per_cycle": 256,
          "max_prefill_layers_per_cycle": 4
        },
        "soak": {
          "cancellation_after_semantic_deltas": 4,
          "cancellation_max_tokens": 512,
          "cancellation_prompt_words": 48,
          "cancel_every_waves": 5,
          "gpu_memory_scope": "device_global",
          "gpu_memory_source": "server_metrics:kiln_gpu_memory_bytes{kind=\"used\"}",
          "accelerator_telemetry": {
            "active_busy_floor_percent": 50,
            "amd_gpu_vendor_id": "0x1002",
            "device_selector": "exactly_one_amd_drm_device",
            "mode": "required",
            "poll_interval_ms": 250,
            "sources": {
              "busy": "drm_device/gpu_busy_percent",
              "edge_temperature": "amdgpu_hwmon/temp_edge_input",
              "power": "amdgpu_hwmon/power_PPT_average",
              "sclk": "amdgpu_hwmon/freq_sclk_input",
              "sclk_advertised_max": "drm_device/pp_dpm_sclk"
            }
          },
          "active_gpu_peak_growth_limit_bytes": 536870912,
          "max_tokens": 32,
          "rocm_graph_cache_entries": 12,
          "memory_growth_limit_bytes": 536870912,
          "minimum_duration_seconds": 1800.0,
          "outlier_absolute_ms": 250,
          "outlier_history_size": 64,
          "outlier_multiplier": 5,
          "prompt_assignment": "slot_by_request",
          "prompt_identity": "fixed_by_slot_measured_unique_by_epoch_warmup",
          "prompt_words": {
            "slot_0": 16,
            "slot_1": 32,
            "slot_2": 64,
            "slot_3": 128,
            "slot_4": 256,
            "slot_5": 384,
            "slot_6": 512,
            "slot_7": 768,
            "slot_8": 96,
            "slot_9": 192,
            "slot_10": 1024,
            "slot_11": 48
          },
          "response_oracle": "ascending_zero_padded_integers_prefix_v1",
          "response_oracle_integer_width": 6,
          "request_ignore_eos": true,
          "request_worker_cleanup_timeout_seconds": 10.0,
          "deadline_policy": "independent_build_setup_and_measurement",
          "measurement_deadline_seconds": 1920,
          "qualification_case_timeout_seconds": 4200,
          "setup_deadline_seconds": 1200,
          "teardown_grace_seconds": 180,
          "stabilization_gpu_delta_limit_bytes": 67108864,
          "stabilization_memory_boundary": "gpu_and_rss",
          "stabilization_max_cycles": 8,
          "stabilization_min_cycles": 4,
          "stabilization_required_stable_cycles": 2,
          "stabilization_rss_delta_limit_bytes": 16777216,
          "stabilization_rss_growth_limit_bytes": null,
          "steady_state_warmup_max_waves": 16,
          "vulkan_buffer_pool_gb": 3.0,
          "wave_concurrency": {
            "wave_0": 1,
            "wave_1": 8,
            "wave_2": 12,
            "wave_3": 8
          },
          "rocm_graph_admission_policy": "idle_owner_lru_then_active_fair_lru",
          "rocm_graph_active_owner_floor": 1,
          "rocm_graph_transition_headroom_entries": 0,
          "host_mem_available_floor_bytes": 8589934592,
          "host_swap_growth_limit_bytes": 536870912,
          "host_memory_poll_interval_ms": 250,
          "host_thermal_guard": {
            "limit_millicelsius": 97000,
            "poll_interval_ms": 250,
            "sensor": {
              "hwmon_name": "k10temp",
              "label": "Tctl"
            }
          },
          "host_thermal_cooldown": {
            "mode": "post_process_exit_consecutive_samples",
            "poll_interval_ms": 250,
            "scope": "host_package",
            "stable_samples": 8,
            "target_millicelsius": 75000,
            "timeout_seconds": 180.0
          },
          "host_thermal_pacing": {
            "deadline_accounting": "included",
            "itl_attribution": "host_thermal_pacing",
            "mode": "continuous_process_group_stop",
            "pause_signal": "SIGSTOP",
            "poll_interval_ms": 250,
            "resume_millicelsius": 86000,
            "resume_signal": "SIGCONT",
            "scope": "server_process_group",
            "start_millicelsius": 88000
          }
        }
      },
      "cases": [
        {
          "id": "continuous-mixed-load",
          "description": "Build current source once, retain one server process, and run mixed fixed-output waves with periodic cancellation for at least 30 minutes.",
          "required": true,
          "command": [
            "python3",
            "scripts/qualification/serve_rocm_soak.py",
            "--model-path",
            "${model_path}",
            "--seed",
            "${seed}",
            "--minimum-duration-seconds",
            "1800",
            "--memory-growth-limit-bytes",
            "536870912"
          ],
          "working_directory": ".",
          "environment": {
            "CARGO_NET_OFFLINE": "true",
            "PYTHONUNBUFFERED": "1",
            "ROCM_PATH": "/opt/rocm"
          },
          "timeout_seconds": 4200,
          "expected_exit_codes": [
            0
          ],
          "output_assertions": [
            {
              "stream": "combined",
              "match": "forbidden",
              "pattern": "(?i)(no rocm device|rocm (?:device )?(?:is )?(?:not available|unavailable)|skipp(?:ed|ing)[^\\r\\n]{0,160}rocm (?:device|test|hardware))"
            }
          ],
          "result_protocol": {
